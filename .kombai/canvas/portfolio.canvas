-auto flex flex-col md:flex-row justify-between items-center gap-8 text-[10px] tracking-[0.3em] text-white/30 uppercase font-bold\" data-kid=\"238\">\n                <div data-kid=\"239\">© 2024 K.MAKIREDDI // ALL_RIGHTS_RESERVED</div>\n                <div class=\"flex items-center gap-6\" data-kid=\"240\">\n                    <span class=\"text-cyan-500/50\" data-kid=\"241\">NODE_01_REACHABLE</span>\n                    <span class=\"text-orange-500/50\" data-kid=\"242\">SECURE_DATA_LINE</span>\n                </div>\n                <div data-kid=\"243\">CORE_VERSION: 4.2.0_STABLE</div>\n            </div>\n            \n            <div class=\"absolute bottom-0 left-0 w-full h-[1px] bg-cyan-500/20\" data-kid=\"244\"></div>\n        </footer>\n    </div>\n\n    \n    <style data-kid=\"245\">\n        @keyframes scan {\n            0% { transform: translateY(-100%); opacity: 0; }\n            10% { opacity: 0.5; }\n            90% { opacity: 0.5; }\n            100% { transform: translateY(1200%); opacity: 0; }\n        }\n        @keyframes blink {\n            0%, 100% { opacity: 1; }\n            50% { opacity: 0; }\n        }\n    </style>\n</div>\n",
