      "html": "\n<div class=\"bg-[#0A0F14] text-slate-300 font-sans selection:bg-[#E04F3E]/30 selection:text-white\" data-kid=\"0\">\n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=Inter:wght@300;400;600;700&family=JetBrains+Mono:wght@400;500&display=swap');\n\n        .font-syne { font-family: 'Syne', sans-serif; }\n        .font-mono { font-family: 'JetBrains Mono', monospace; }\n\n        .glass {\n            background: rgba(15, 23, 42, 0.6);\n            backdrop-filter: blur(12px);\n            border: 1px solid rgba(255, 255, 255, 0.05);\n        }\n\n        .glow-teal { box-shadow: 0 0 20px rgba(13, 148, 136, 0.2); }\n        .glow-orange { box-shadow: 0 0 20px rgba(224, 79, 62, 0.2); }\n\n        .scanline {\n            width: 100%;\n            height: 100px;\n            z-index: 5;\n            background: linear-gradient(0deg, rgba(0, 0, 0, 0) 0%, rgba(224, 79, 62, 0.1) 50%, rgba(0, 0, 0, 0) 100%);\n            opacity: 0.2;\n            position: absolute;\n            bottom: 100%;\n            animation: scanline 8s linear infinite;\n        }\n\n        @keyframes scanline {\n            0% { bottom: 100%; }\n            100% { bottom: -100px; }\n        }\n\n        .data-stream {\n            position: absolute;\n            width: 1px;\n            background: linear-gradient(to bottom, transparent, #E04F3E, transparent);\n            animation: stream 15s linear infinite;\n        }\n\n        @keyframes stream {\n            0% { transform: translateY(-100%); opacity: 0; }\n            50% { opacity: 0.3; }\n            100% { transform: translateY(1000%); opacity: 0; }\n        }\n\n        .blink {\n            animation: blink 1s step-end infinite;\n        }\n\n        @keyframes blink {\n            50% { opacity: 0; }\n        }\n\n        .connection-line {\n            position: absolute;\n            width: 1px;\n            background: linear-gradient(to bottom, transparent, #E04F3E, transparent);\n            opacity: 0.3;\n        }\n\n        .data-module {\n            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n        }\n\n        .data-module:hover {\n            transform: translateY(-5px);\n            border-color: rgba(224, 79, 62, 0.4);\n            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);\n        }\n    </style>\n\n    \n    <nav class=\"absolute top-0 left-0 w-full z-50 p-6 flex justify-between items-center glass border-b border-white/5\" data-kid=\"2\">\n        <div class=\"flex items-center gap-3\" data-kid=\"3\">\n            <div class=\"w-8 h-8 bg-[#E04F3E] flex items-center justify-center font-bold text-black text-sm\" data-kid=\"4\">KM</div>\n            <span class=\"font-mono text-xs tracking-widest uppercase text-white\" data-kid=\"5\">System: MK-01.v.2024</span>\n        </div>\n        <div class=\"hidden md:flex gap-10 text-[10px] font-mono tracking-widest uppercase\" data-kid=\"6\">\n            <a href=\"#about\" class=\"hover:text-[#E04F3E] transition-colors\" data-kid=\"7\">01//About</a>\n            <a href=\"#experience\" class=\"hover:text-[#E04F3E] transition-colors\" data-kid=\"8\">02//Exp</a>\n            <a href=\"#projects\" class=\"hover:text-[#E04F3E] transition-colors\" data-kid=\"9\">03//Dev</a>\n            <a href=\"#contact\" class=\"hover:text-[#E04F3E] transition-colors\" data-kid=\"10\">04//Terminal</a>\n        </div>\n        <button class=\"px-5 py-2 border border-[#0D9488]/30 text-[#0D9488] text-[10px] font-mono uppercase tracking-[0.2em] hover:bg-[#0D9488]/10 transition-all\" data-kid=\"11\">\n            Initiate Contact\n        </button>\n    </nav>\n\n    \n    <section class=\"relative h-[850px] flex flex-col items-center justify-center overflow-hidden\" data-kid=\"12\">\n        \n        <div class=\"absolute inset-0 z-0\" data-kid=\"13\">\n            <video src=\"https://player.vimeo.com/external/494252666.sd.mp4?s=727e0239665c5531d279774619d8544f86d8b02c&profile_id=164&oauth2_token_id=57447761\" poster=\"https://images.pexels.com/photos/3129957/pexels-photo-3129957.jpeg?auto=compress&cs=tinysrgb&w=1280&q=80\" autoplay muted loop playsinline class=\"w-full h-full object-cover opacity-40 grayscale\" data-kid=\"14\"></video>\n            <div class=\"absolute inset-0 bg-gradient-to-b from-[#0A0F14] via-transparent to-[#0A0F14]\" data-kid=\"15\"></div>\n            <div class=\"scanline\" data-kid=\"16\"></div>\n        </div>\n\n        \n        <div class=\"relative z-10 text-center px-6\" data-kid=\"17\">\n            <div class=\"mb-8 flex flex-col items-center\" data-kid=\"18\">\n                <span class=\"px-3 py-1 bg-[#E04F3E]/10 border border-[#E04F3E]/30 text-[#E04F3E] text-[10px] font-mono uppercase tracking-widest mb-4\" data-kid=\"19\">\n                    Architecting the Future of Logistics\n                </span>\n                <h1 class=\"text-5xl md:text-7xl lg:text-8xl font-syne font-extrabold text-white tracking-tighter leading-none px-4\" data-kid=\"20\">\n                    KESHAVARDHAN<br data-kid=\"21\">\n                    <span class=\"text-transparent border-t-2 border-white/10 drop-shadow-[0_0_10px_rgba(255,255,255,0.1)]\" style=\"-webkit-text-stroke: 1.5px rgba(255,255,255,0.4);\" data-kid=\"22\">MAKIREDDI</span>\n                </h1>\n            </div>\n            \n            <div class=\"flex items-center justify-center gap-6 max-w-2xl mx-auto\" data-kid=\"23\">\n                <div class=\"h-px grow bg-[#0D9488]/40\" data-kid=\"24\"></div>\n                <p class=\"text-slate-400 font-mono text-sm tracking-[0.3em] uppercase whitespace-nowrap\" data-kid=\"25\">The Invisible Supply Chain</p>\n                <div class=\"h-px grow bg-[#0D9488]/40\" data-kid=\"26\"></div>\n            </div>\n\n            <div class=\"mt-16 animate-bounce opacity-40\" data-kid=\"27\">\n                <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"28\">\n                    <path d=\"M7 13l5 5 5-5M7 6l5 5 5-5\" data-kid=\"29\"></path>\n                </svg>\n            </div>\n        </div>\n\n        \n        <div class=\"absolute top-1/4 left-10 text-[10px] font-mono text-slate-500 hidden xl:block\" data-kid=\"30\">\n            <p data-kid=\"31\">// DATA_LAT: 17.3850° N</p>\n            <p data-kid=\"32\">// DATA_LNG: 78.4867° E</p>\n            <p class=\"text-[#0D9488]\" data-kid=\"33\">STATUS: SYNCED</p>\n        </div>\n    </section>\n\n    \n    <main class=\"relative z-10 max-w-7xl mx-auto px-6 pb-40 space-y-40\" data-kid=\"34\">\n        \n        \n        <section id=\"about\" class=\"grid grid-cols-1 lg:grid-cols-2 gap-20 items-center\" data-kid=\"35\">\n            <div class=\"space-y-8\" data-kid=\"36\">\n                <div class=\"flex items-center gap-4\" data-kid=\"37\">\n                    <span class=\"text-xs font-mono text-[#E04F3E]\" data-kid=\"38\">01/ABOUT</span>\n                    <div class=\"h-px w-20 bg-slate-800\" data-kid=\"39\"></div>\n                </div>\n                <h2 class=\"text-5xl font-syne font-bold text-white tracking-tight leading-tight\" data-kid=\"40\">\n                    Bridging Physical Assets with <span class=\"text-[#0D9488]\" data-kid=\"41\">Digital Intelligence</span>.\n                </h2>\n                <p class=\"text-lg text-slate-400 leading-relaxed max-w-xl\" data-kid=\"42\">\n                    I am a supply chain visionary specializing in the \"Invisible Supply Chain\"—the complex, automated back-end systems that drive global commerce. My work focuses on leveraging IoT, blockchain, and AI to create frictionless logistics ecosystems.\n                </p>\n                <div class=\"grid grid-cols-2 gap-6 pt-6\" data-kid=\"43\">\n                    <div class=\"p-4 border border-white/5 glass\" data-kid=\"44\">\n                        <span class=\"block text-2xl font-bold text-[#E04F3E] mb-1\" data-kid=\"45\">08+</span>\n                        <span class=\"text-[10px] font-mono uppercase text-slate-500\" data-kid=\"46\">Years Industry Experience</span>\n                    </div>\n                    <div class=\"p-4 border border-white/5 glass\" data-kid=\"47\">\n                        <span class=\"block text-2xl font-bold text-[#0D9488] mb-1\" data-kid=\"48\">40+</span>\n                        <span class=\"text-[10px] font-mono uppercase text-slate-500\" data-kid=\"49\">Projects Deployed</span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"relative group\" data-kid=\"50\">\n                <div class=\"absolute inset-0 bg-[#E04F3E]/10 blur-3xl rounded-full opacity-30 group-hover:opacity-50 transition-opacity\" data-kid=\"51\"></div>\n                <div class=\"relative glass aspect-square flex items-center justify-center overflow-hidden border border-white/10\" data-kid=\"52\">\n                    <img src=\"https://images.pexels.com/photos/1036623/pexels-photo-1036623.jpeg?auto=compress&cs=tinysrgb&w=800&q=80\" alt=\"Profile\" class=\"w-full h-full object-cover mix-blend-screen opacity-60 grayscale hover:grayscale-0 transition-all duration-1000\" decoding=\"async\" loading=\"lazy\" data-kid=\"53\">\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-[#0A0F14] to-transparent\" data-kid=\"54\"></div>\n                    \n                    <div class=\"absolute inset-0 opacity-20 pointer-events-none\" style=\"background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 20px 20px;\" data-kid=\"55\"></div>\n                </div>\n                \n                <div class=\"absolute -bottom-6 -right-6 p-6 glass border border-[#E04F3E]/30 text-white w-64 shadow-2xl\" data-kid=\"56\">\n                    <p class=\"text-[10px] font-mono text-[#E04F3E] mb-2\" data-kid=\"57\">// BIOSYNC_READY</p>\n                    <p class=\"text-sm font-medium italic\" data-kid=\"58\">\"We don't just ship goods; we orchestrate signals across the global nervous system.\"</p>\n                </div>\n            </div>\n        </section>\n\n        \n        <section id=\"experience\" class=\"space-y-16\" data-kid=\"59\">\n            <div class=\"flex justify-between items-end\" data-kid=\"60\">\n                <div class=\"space-y-4\" data-kid=\"61\">\n                    <span class=\"text-xs font-mono text-[#E04F3E]\" data-kid=\"62\">02/EXPERIENCE</span>\n                    <h2 class=\"text-4xl font-syne font-bold text-white uppercase tracking-tight\" data-kid=\"63\">Professional Nodes</h2>\n                </div>\n                <div class=\"hidden md:block text-right\" data-kid=\"64\">\n                    <span class=\"text-[10px] font-mono text-slate-500\" data-kid=\"65\">FILTER: [ALL_CHRONOLOGICAL]</span>\n                </div>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\" data-kid=\"66\">\n                \n                <div class=\"data-module glass p-8 border-l-2 border-l-[#E04F3E] relative overflow-hidden\" data-kid=\"67\">\n                    <div class=\"absolute top-0 right-0 p-2 bg-[#E04F3E]/10 border-b border-l border-white/5 text-[8px] font-mono text-[#E04F3E] tracking-widest\" data-kid=\"68\">RUNNING_01</div>\n                    <div class=\"flex justify-between items-start mb-6\" data-kid=\"69\">\n                        <div data-kid=\"70\">\n                            <span class=\"text-[10px] font-mono text-[#0D9488] mb-1 block font-bold\" data-kid=\"71\">2021 — PRESENT</span>\n                            <h3 class=\"text-2xl font-bold text-white tracking-tight\" data-kid=\"72\">Senior Logistics Architect</h3>\n                            <p class=\"text-[#E04F3E] font-mono text-xs mt-1\" data-kid=\"73\"