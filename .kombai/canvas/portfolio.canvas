1px] bg-gradient-to-r from-transparent via-orange-500 to-transparent animate-[scan_4s_infinite]\" data-kid=\"214\"></div>\n                        \n                        <div class=\"space-y-4\" data-kid=\"215\">\n                            <label class=\"text-[10px] tracking-[0.3em] font-bold text-orange-500\" data-kid=\"216\">SET_SENDER_IDENTITY</label>\n                            <div class=\"relative\" data-kid=\"217\">\n                                <span class=\"absolute left-0 top-1/2 -translate-y-1/2 text-orange-500/50\" data-kid=\"218\">></span>\n                                <input type=\"text\" placeholder=\"GUEST_ID_1289\" class=\"w-full bg-orange-500/5 border-b border-orange-500/30 py-3 pl-6 focus:border-orange-500 focus:bg-orange-500/10 outline-hidden text-sm text-white placeholder:text-orange-500/20 transition-all\" data-kid=\"219\">\n                            </div>\n                        </div>\n\n                        <div class=\"space-y-4\" data-kid=\"220\">\n                            <label class=\"text-[10px] tracking-[0.3em] font-bold text-orange-500\" data-kid=\"221\">ESTABLISH_RETURN_LINK</label>\n                            <div class=\"relative\" data-kid=\"222\">\n                                <span class=\"absolute left-0 top-1/2 -translate-y-1/2 text-orange-500/50\" data-kid=\"223\">></span>\n                                <input type=\"email\" placeholder=\"ENCRYPTED_ADDR@DOMAIN.SYS\" class=\"w-full bg-orange-500/5 border-b border-orange-500/30 py-3 pl-6 focus:border-orange-500 focus:bg-orange-500/10 outline-hidden text-sm text-white placeholder:text-orange-500/20 transition-all\" data-kid=\"224\">\n                            </div>\n                        </div>\n\n                        <div class=\"space-y-4\" data-kid=\"225\">\n                            <label class=\"text-[10px] tracking-[0.3em] font-bold text-orange-500\" data-kid=\"226\">TRANSMISSION_PAYLOAD</label>\n                            <textarea