      "html": "<div class=\"relative w-full min-h-[900px] bg-[#050505] text-[#f4f1ea] font-sans overflow-hidden\" data-kid=\"0\">\n  \n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Roboto+Mono:wght@200;400;600&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap');\n    \n    .font-editorial-header {\n      font-family: 'Cinzel', serif;\n    }\n    .font-serif-body {\n      font-family: 'Playfair Display', serif;\n    }\n    .font-mono-ind {\n      font-family: 'Roboto Mono', monospace;\n    }\n\n    @keyframes rotate-slow {\n      0% { transform: rotate(0deg); }\n      100% { transform: rotate(360deg); }\n    }\n    .animate-rotate-slow {\n      animation: rotate-slow 20s linear infinite;\n    }\n  </style>\n\n  \n  <div class=\"absolute inset-0 z-0 bg-[linear-gradient(to_right,#ffffff03_1px,transparent_1px),linear-gradient(to_bottom,#ffffff03_1px,transparent_1px)] bg-[size:100px_100px]\" data-kid=\"2\"></div>\n  \n  \n  <div class=\"absolute -top-[30%] -right-[10%] w-[600px] h-[600px] rounded-full bg-[#a93226] opacity-[0.08] blur-[150px]\" data-kid=\"3\"></div>\n  <div class=\"absolute bottom-[5%] left-[5%] w-[400px] h-[400px] rounded-full bg-neutral-900 opacity-50 blur-[100px]\" data-kid=\"4\"></div>\n\n  \n  <div class=\"relative z-10 max-w-7xl mx-auto px-10 pt-8 pb-16 flex flex-col justify-between min-h-[900px]\" data-kid=\"5\">\n    \n    \n    <header class=\"flex items-center justify-between border-b border-white/10 pb-8\" data-kid=\"6\">\n      <div class=\"flex items-center gap-4\" data-kid=\"7\">\n        \n        <span class=\"text-3xl font-light tracking-widest text-[#a93226] font-editorial-header\" data-kid=\"8\">H // R</span>\n        <div class=\"h-4 w-px bg-white/20\" data-kid=\"9\"></div>\n        <span class=\"text-[9px] font-mono-ind text-neutral-400 uppercase tracking-[0.3em]\" data-kid=\"10\">SUPPLY CHAIN ARTISTRY</span>\n      </div>\n\n      <nav class=\"hidden md:flex items-center gap-10 text-[9px] font-mono-ind text-neutral-400 tracking-[0.2em] uppercase\" data-kid=\"11\">\n        <a href=\"#education\" class=\"hover:text-white transition-colors relative group py-1\" data-kid=\"12\">\n          <span data-kid=\"13\">01. EDUCATION</span>\n          <span class=\"absolute bottom-0 left-0 w-0 h-px bg-[#a93226] group-hover:w-full transition-all duration-300\" data-kid=\"14\"></span>\n        </a>\n        <a href=\"#experience\" class=\"hover:text-white transition-colors relative group py-1\" data-kid=\"15\">\n          <span data-kid=\"16\">02. EXPERIENCE</span>\n          <span class=\"absolute bottom-0 left-0 w-0 h-px bg-[#a93226] group-hover:w-full transition-all duration-300\" data-kid=\"17\"></span>\n        </a>\n        <a href=\"#projects\" class=\"hover:text-white transition-colors relative group py-1\" data-kid=\"18\">\n          <span data-kid=\"19\">03. PROJECTS</span>\n          <span class=\"absolute bottom-0 left-0 w-0 h-px bg-[#a93226] group-hover:w-full transition-all duration-300\" data-kid=\"20\"></span>\n        </a>\n        <a href=\"#publications\" class=\"hover:text-white transition-colors relative group py-1\" data-kid=\"21\">\n          <span data-kid=\"22\">04. PUBLICATIONS</span>\n          <span class=\"absolute bottom-0 left-0 w-0 h-px bg-[#a93226] group-hover:w-full transition-all duration-300\" data-kid=\"23\"></span>\n        </a>\n      </nav>\n\n      <div class=\"flex items-center gap-3 text-[10px] font-mono-ind text-neutral-400\" data-kid=\"24\">\n        <span class=\"text-[#a93226] font-semibold\" data-kid=\"25\">EDITION 2026</span>\n      </div>\n    </header>\n\n    \n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-16 items-center my-auto py-10\" data-kid=\"26\">\n      \n      \n      <div class=\"lg:col-span-5 space-y-8\" data-kid=\"27\">\n        <div class=\"flex items-center gap-2\" data-kid=\"28\">\n          <span class=\"text-[10px] font-mono-ind text-[#a93226] uppercase tracking-widest\" data-kid=\"29\">[ INDEX 01A_HERO ]</span>\n        </div>\n\n        <h1 class=\"text-4xl md:text-5xl font-light tracking-wide text-white font-editorial-header leading-[1.15]\" data-kid=\"30\">\n          A PRECISE DISCIPLINE OF <br data-kid=\"31\">\n          <span class=\"italic font-serif-body text-[#f4f1ea]/80 font-normal\" data-kid=\"32\">Surrealist Flow.</span>\n        </h1>\n\n        <div class=\"h-px w-20 bg-[#a93226]\" data-kid=\"33\"></div>\n\n        <p class=\"text-neutral-400 text-sm font-light font-serif-body leading-relaxed max-w-sm\" data-kid=\"34\">\n          Fusing heavy-duty supply chain geometry with cinematic clouds, Golden Gate bridge mist, and sophisticated interactive redirections. Designed for collectors of high-end frontend architecture.\n        </p>\n\n        \n        <div class=\"space-y-3 font-mono-ind text-[10px] text-neutral-500\" data-kid=\"35\">\n          <div class=\"flex justify-between border-b border-white/5 pb-2\" data-kid=\"36\">\n            <span data-kid=\"37\">ENGINE STATUS</span>\n            <span class=\"text-emerald-500 font-semibold\" data-kid=\"38\">3D WEBGL ACCELERATED</span>\n          </div>\n          <div class=\"flex justify-between border-b border-white/5 pb-2\" data-kid=\"39\">\n            <span data-kid=\"40\">INTERACTIVE SCROLL</span>\n            <span class=\"text-white\" data-kid=\"41\">ACTIVE ROTATION & PIVOT</span>\n          </div>\n          <div class=\"flex justify-between\" data-kid=\"42\">\n            <span data-kid=\"43\">COLLEGE VIDEOS INFRASTRUCTURE</span>\n            <span class=\"text-[#a93226] hover:underline cursor-pointer\" data-kid=\"44\">PREVIEW BLOCK 02</span>\n          </div>\n        </div>\n\n        \n        <div class=\"pt-4 flex items-center gap-6\" data-kid=\"45\">\n          <a href=\"#education\" class=\"group relative inline-flex items-center gap-3 px-8 py-4 border border-[#a93226] hover:bg-[#a93226] text-white font-semibold text-xs tracking-widest font-mono-ind uppercase transition-all duration-300\" data-kid=\"46\">\n            <span data-kid=\"47\">EXPLORE DECK</span>\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" class=\"transform group-hover:translate-x-1.5 transition-transform\" data-kid=\"48\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\" data-kid=\"49\"></line><polyline points=\"12 5 19 12 12 19\" data-kid=\"50\"></polyline></svg>\n          </a>\n        </div>\n      </div>\n\n      \n      <div class=\"lg:col-span-7 flex flex-col justify-center items-center relative\" data-kid=\"51\">\n        \n        \n        <div class=\"relative w-full max-w-[560px] aspect-[16/10] bg-[#0c0c0c] border-4 border-[#121212] shadow-2xl p-2 group hover:border-[#a93226]/50 transition-colors duration-500\" data-kid=\"52\">\n          \n          \n          <div class=\"absolute -top-1.5 -left-1.5 w-4 h-4 border-t-2 border-l-2 border-[#a93226]\" data-kid=\"53\"></div>\n          <div class=\"absolute -bottom-1.5 -right-1.5 w-4 h-4 border-b-2 border-r-2 border-[#a93226]\" data-kid=\"54\"></div>\n\n          <div class=\"relative w-full h-full overflow-hidden bg-black\" data-kid=\"55\">\n            \n            <img src=\"/api/local/images/public/screenshot-1.png\" alt=\"HappyRobot Golden Gate Bridge theme in clouds\" decoding=\"async\" loading=\"lazy\" class=\"w-full h-full object-cover filter contrast-[1.08] saturate-[1.05] brightness-90 transition-transform duration-700 group-hover:scale-105\" data-kid=\"56\">\n            \n            \n            <div class=\"absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent\" data-kid=\"57\"></div>\n\n            \n            <div class=\"absolute top-4 right-4 w-10 h-10 rounded-full border border-white/20 bg-black/60 backdrop-blur-md flex items-center justify-center\" data-kid=\"58\">\n              <i class=\"ti ti-crosshair text-neutral-400 text-sm animate-rotate-slow\" data-kid=\"59\"></i>\n            </div>\n\n            \n            <div class=\"absolute bottom-4 left-4 right-4 flex items-end justify-between\" data-kid=\"60\">\n              <div class=\"text-left\" data-kid=\"61\">\n                <p class=\"text-[9px] font-mono-ind text-[#a93226] uppercase tracking-wider font-semibold\" data-kid=\"62\">VIEWPORT_3D_LIVE</p>\n                <h3 class=\"text-sm font-editorial-header text-white font-bold\" data-kid=\"63\">THE GOLDEN GATE GATEWAY</h3>\n              </div>\n              <div class=\"px-2.5 py-1 bg-black/80 backdrop-blur-sm border border-white/10 text-[8px] font-mono-ind text-neutral-400 rounded\" data-kid=\"64\">\n                SEC_01_HERO\n              </div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"absolute -bottom-10 -right-4 w-[240px] bg-[#121212] border border-white/10 p-3 shadow-2xl rounded-sm transform rotate-1 hover:rotate-0 transition-transform duration-300\" data-kid=\"65\">\n          <div class=\"flex items-center justify-between border-b border-white/5 pb-2 mb-2\" data-kid=\"66\">\n            <span class=\"text-[8px] font-mono-ind text-neutral-500\" data-kid=\"67\">ACADEMIC_PORT // 02</span>\n            <span class=\"w-1.5 h-1.5 rounded-full bg-[#a93226]\" data-kid=\"68\"></span>\n          </div>\n          \n          <div class=\"relative w-full h-[110px] bg-black rounded-sm overflow-hidden mb-2\" data-kid=\"69\">\n            <video src=\"https://videos.pexels.com/video-files/10472331/10472331-hd_1920_1080_25fps.mp4\" poster=\"https://images.pexels.com/videos/10472331/pexels-photo-10472331.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-full object-cover grayscale\" data-kid=\"70\"></video>\n            <div class=\"absolute inset-0 bg-[#a93226]/20 mix-blend-overlay\" data-kid=\"71\"></div>\n            <div class=\"absolute inset-0 flex items-center justify-center\" data-kid=\"72\">\n              <div class=\"w-8 h-8 rounded-full bg-black/60 border border-white/20 flex items-center justify-center\" data-kid=\"73\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" class=\"text-white fill-white\" data-kid=\"74\"><polygon points=\"6 3 20 12 6 21 6 3\" data-kid=\"75\"></polygon></svg>\n              </div>\n            </div>\n          </div>\n          <div class=\"text-[10px] font-editorial-header text-white font-semibold\" data-kid=\"76\">COLLEGE INFRASTRUCTURE</div>\n          <p class=\"text-[9px] text-neutral-400 font-sans leading-relaxed mt-0.5\" data-kid=\"77\">3D cinematic tour of campus terminals & active lab spaces.</p>\n        </div>\n\n      </div>\n\n    </div>\n\n    \n    <div class=\"border-t border-white/10 pt-6 flex flex-wrap items-center justify-between gap-4 text-[9px] font-mono-ind text-neutral-500\" data-kid=\"78\">\n      <div data-kid=\"79\">\n        <span data-kid=\"80\">COORDINATES: SF_BAY_37.77</span>\n      </div>\n      <div data-kid=\"81\">\n        <span data-kid=\"82\">THE HAPPY ROBOT EXPERIENCE © ALL SECURE</span>\n      </div>\n    </div>\n\n  </div>\n</div>",
