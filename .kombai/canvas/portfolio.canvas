      "html": "<div class=\"relative w-full min-h-[900px] bg-[#07090e] text-[#f8f9fa] font-sans overflow-hidden\" data-kid=\"0\">\n  \n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Inter:wght@300;400;500;600;700&display=swap');\n    \n    .font-serif-lux {\n      font-family: 'Playfair Display', serif;\n    }\n    .font-mono-tech {\n      font-family: 'JetBrains Mono', monospace;\n    }\n    .font-sans-clean {\n      font-family: 'Inter', sans-serif;\n    }\n    \n    /* Subtle floating animation for 3D look */\n    @keyframes float-gentle {\n      0%, 100% { transform: translateY(0px) rotate(0deg); }\n      50% { transform: translateY(-12px) rotate(0.5deg); }\n    }\n    @keyframes float-slow {\n      0%, 100% { transform: translateY(0px) rotate(0deg); }\n      50% { transform: translateY(-8px) rotate(-1deg); }\n    }\n    @keyframes pulse-slow {\n      0%, 100% { opacity: 0.2; }\n      50% { opacity: 0.4; }\n    }\n    .animate-float-gentle {\n      animation: float-gentle 6s ease-in-out infinite;\n    }\n    .animate-float-slow {\n      animation: float-slow 8s ease-in-out infinite;\n    }\n    .animate-pulse-slow {\n      animation: pulse-slow 4s ease-in-out infinite;\n    }\n  </style>\n\n  \n  <div class=\"absolute inset-0 z-0\" data-kid=\"2\">\n    <img src=\"/api/local/images/public/screenshot-2.png\" alt=\"Industrial Surreal Mountains with Floating Containers\" decoding=\"async\" loading=\"lazy\" class=\"w-full h-full object-cover opacity-35 filter brightness-90 saturate-110\" data-kid=\"3\">\n    <div class=\"absolute inset-0 bg-gradient-to-b from-[#07090e]/80 via-transparent to-[#07090e]\" data-kid=\"4\"></div>\n    <div class=\"absolute inset-0 bg-gradient-to-r from-[#07090e] via-transparent to-[#07090e]\" data-kid=\"5\"></div>\n  </div>\n\n  \n  <div class=\"absolute inset-0 z-0 bg-[linear-gradient(to_right,#1f2937_1px,transparent_1px),linear-gradient(to_bottom,#1f2937_1px,transparent_1px)] bg-[size:4rem_4.5rem] opacity-[0.07]\" data-kid=\"6\"></div>\n\n  \n  <div class=\"absolute top-[20%] left-[10%] w-[350px] h-[350px] rounded-full bg-[#cba36d] opacity-10 blur-[120px] animate-pulse-slow\" data-kid=\"7\"></div>\n  <div class=\"absolute bottom-[10%] right-[10%] w-[450px] h-[450px] rounded-full bg-[#bf4e30] opacity-10 blur-[150px] animate-pulse-slow\" data-kid=\"8\"></div>\n\n  \n  <div class=\"relative z-10 max-w-7xl mx-auto px-8 pt-6 pb-24 flex flex-col justify-between min-h-[900px]\" data-kid=\"9\">\n    \n    \n    <header class=\"flex items-center justify-between border-b border-white/5 pb-6\" data-kid=\"10\">\n      <div class=\"flex items-center gap-3\" data-kid=\"11\">\n        \n        <div class=\"flex gap-1.5 h-8\" data-kid=\"12\">\n          <div class=\"w-2.5 h-full bg-[#cba36d] rounded-sm transform -skew-x-12\" data-kid=\"13\"></div>\n          <div class=\"w-2.5 h-full bg-white rounded-sm transform -skew-x-12\" data-kid=\"14\"></div>\n        </div>\n        <span class=\"text-xl font-bold tracking-widest text-white uppercase font-sans-clean\" data-kid=\"15\">HappyRobot</span>\n      </div>\n      \n      <nav class=\"hidden md:flex items-center gap-8 text-[11px] tracking-[0.25em] uppercase font-mono-tech text-neutral-400\" data-kid=\"16\">\n        <a href=\"#education\" class=\"hover:text-white transition-colors duration-300\" data-kid=\"17\">Education</a>\n        <a href=\"#experience\" class=\"hover:text-white transition-colors duration-300\" data-kid=\"18\">Experience</a>\n        <a href=\"#projects\" class=\"hover:text-white transition-colors duration-300\" data-kid=\"19\">Projects</a>\n        <a href=\"#publications\" class=\"hover:text-white transition-colors duration-300\" data-kid=\"20\">Publications</a>\n        <a href=\"#skills\" class=\"hover:text-white transition-colors duration-300\" data-kid=\"21\">Skills</a>\n      </nav>\n\n      <div class=\"flex items-center gap-4\" data-kid=\"22\">\n        <a href=\"#contact\" class=\"px-5 py-2.5 bg-white/5 border border-white/10 hover:border-[#cba36d]/50 hover:bg-[#cba36d]/10 text-[10px] tracking-[0.2em] font-mono-tech uppercase text-[#cba36d] transition-all duration-300 rounded-sm\" data-kid=\"23\">\n          Access Terminal\n        </a>\n      </div>\n    </header>\n\n    \n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center my-auto pt-10\" data-kid=\"24\">\n      \n      \n      <div class=\"lg:col-span-6 flex flex-col space-y-8\" data-kid=\"25\">\n        \n        <div class=\"inline-flex items-center gap-3\" data-kid=\"26\">\n          <span class=\"px-2 py-0.5 border border-[#cba36d]/30 text-[#cba36d] text-[10px] font-mono-tech uppercase tracking-widest bg-[#cba36d]/5\" data-kid=\"27\">System Ver 4.01</span>\n          <div class=\"h-px w-12 bg-neutral-800\" data-kid=\"28\"></div>\n          <span class=\"text-[10px] font-mono-tech text-neutral-400 uppercase tracking-widest\" data-kid=\"29\">3D Industrial Portfolio</span>\n        </div>\n\n        \n        <h1 class=\"text-5xl md:text-7xl font-light tracking-tight text-white font-serif-lux leading-[1.05]\" data-kid=\"30\">\n          Constructing <br data-kid=\"31\">\n          <span class=\"italic text-[#cba36d]\" data-kid=\"32\">Surreal</span> <br data-kid=\"33\">\n          Architecture.\n        </h1>\n\n        <p class=\"text-neutral-400 text-sm md:text-base font-sans-clean leading-relaxed max-w-lg\" data-kid=\"34\">\n          An aesthetic portfolio demonstrating a high-fidelity combination of engineering discipline, supply-chain visual weight, and cutting-edge interactive architectures.\n        </p>\n\n        \n        <div class=\"flex flex-wrap gap-4 pt-4\" data-kid=\"35\">\n          <a href=\"#projects\" class=\"group relative px-8 py-4 bg-[#cba36d] text-[#07090e] font-bold text-xs tracking-[0.2em] font-mono-tech uppercase overflow-hidden rounded-sm transition-all duration-300 shadow-[0_4px_20px_rgba(203,163,109,0.25)] hover:shadow-[0_4px_30px_rgba(203,163,109,0.4)]\" data-kid=\"36\">\n            <span class=\"relative z-10\" data-kid=\"37\">Deploy Index</span>\n            <div class=\"absolute inset-0 bg-white transform translate-y-full group-hover:translate-y-0 transition-transform duration-300\" data-kid=\"38\"></div>\n          </a>\n          <a href=\"#video-tour\" class=\"flex items-center gap-3 px-8 py-4 border border-white/10 hover:border-white/30 hover:bg-white/5 text-white text-xs tracking-[0.2em] font-mono-tech uppercase rounded-sm transition-all duration-300\" data-kid=\"39\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"text-[#cba36d]\" data-kid=\"40\"><polygon points=\"6 3 20 12 6 21 6 3\" data-kid=\"41\"></polygon></svg>\n            <span data-kid=\"42\">Play Cinematic</span>\n          </a>\n        </div>\n\n        \n        <div class=\"grid grid-cols-3 gap-6 pt-10 border-t border-white/5\" data-kid=\"43\">\n          <div data-kid=\"44\">\n            <div class=\"text-[10px] font-mono-tech text-[#cba36d] uppercase tracking-wider mb-1\" data-kid=\"45\">[ LATITUDE ]</div>\n            <div class=\"text-lg font-bold text-white font-sans-clean\" data-kid=\"46\">37.7749° N</div>\n          </div>\n          <div data-kid=\"47\">\n            <div class=\"text-[10px] font-mono-tech text-[#cba36d] uppercase tracking-wider mb-1\" data-kid=\"48\">[ CONSTRUCT ]</div>\n            <div class=\"text-lg font-bold text-white font-sans-clean\" data-kid=\"49\">Heavy Steel</div>\n          </div>\n          <div data-kid=\"50\">\n            <div class=\"text-[10px] font-mono-tech text-[#cba36d] uppercase tracking-wider mb-1\" data-kid=\"51\">[ INDEXED ]</div>\n            <div class=\"text-lg font-bold text-white font-sans-clean\" data-kid=\"52\">15+ Nodes</div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"lg:col-span-6 relative flex items-center justify-center\" data-kid=\"53\">\n        \n        <div class=\"absolute inset-0 bg-gradient-to-tr from-[#cba36d]/10 via-[#bf4e30]/15 to-transparent rounded-2xl blur-3xl opacity-60\" data-kid=\"54\"></div>\n        \n        \n        <div class=\"w-full max-w-[500px] aspect-[4/3] bg-gradient-to-b from-white/10 to-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-4 shadow-[0_20px_50px_rgba(0,0,0,0.5)] transform hover:scale-[1.02] hover:-rotate-1 transition-all duration-500 animate-float-gentle relative group\" data-kid=\"55\">\n          \n          \n          <div class=\"absolute inset-0 border border-[#cba36d]/30 rounded-xl pointer-events-none scale-[1.01] group-hover:scale-[1.02] transition-transform duration-300\" data-kid=\"56\"></div>\n          \n          \n          <div class=\"flex items-center justify-between border-b border-white/10 pb-3 mb-3 text-[10px] font-mono-tech text-neutral-400\" data-kid=\"57\">\n            <span class=\"tracking-wider\" data-kid=\"58\">SEC_H_VIEWER // PRIMARY</span>\n            <div class=\"flex items-center gap-1.5\" data-kid=\"59\">\n              <span class=\"w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse\" data-kid=\"60\"></span>\n              <span class=\"tracking-widest\" data-kid=\"61\">LIVE PORT STREAM</span>\n            </div>\n          </div>\n\n          \n          <div class=\"relative w-full h-[calc(100%-40px)] bg-black/40 rounded-lg overflow-hidden border border-white/5\" data-kid=\"62\">\n            <video src=\"https://videos.pexels.com/video-files/10472331/10472331-hd_1920_1080_25fps.mp4\" poster=\"https://images.pexels.com/videos/10472331/pexels-photo-10472331.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-full object-cover filter contrast-[1.05] brightness-90\" data-kid=\"63\"></video>\n            \n            \n            <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20 pointer-events-none\" data-kid=\"64\"></div>\n            \n            \n            <div class=\"absolute bottom-4 left-4 right-4 flex items-center justify-between bg-black/60 backdrop-blur-md border border-white/10 p-3 rounded-md\" data-kid=\"65\">\n              <div class=\"flex items-center gap-3\" data-kid=\"66\">\n                <div class=\"w-7 h-7 rounded-sm bg-[#cba36d]/15 flex items-center justify-center border border-[#cba36d]/30\" data-kid=\"67\">\n                  <i class=\"ti ti-crosshair text-[#cba36d] text-xs\" data-kid=\"68\"></i>\n                </div>\n                <div data-kid=\"69\">\n                  <div class=\"text-[10px] font-mono-tech text-white uppercase tracking-wider font-semibold\" data-kid=\"70\">Port Terminal [01-B]</div>\n                  <div class=\"text-[9px] font-mono-tech text-neutral-400\" data-kid=\"71\">Location: San Francisco Bay Area</div>\n                </div>\n              </div>\n              <div class=\"w-2.5 h-2.5 rounded-full bg-[#cba36d]/80 animate-ping\" data-kid=\"72\"></div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"absolute -bottom-8 -left-6 bg-[#0c0f17] border border-white/10 p-4 rounded-lg shadow-2xl max-w-[210px] animate-float-slow group hover:border-[#cba36d]/40 transition-colors duration-300\" data-kid=\"73\">\n          <div class=\"text-[#cba36d] text-[9px] font-mono-tech tracking-widest uppercase mb-1\" data-kid=\"74\">SECTION_02</div>\n          <div class=\"text-white text-xs font-semibold font-sans-clean mb-1 group-hover:text-[#cba36d] transition-colors\" data-kid=\"75\">Academic Anchor</div>\n          <div class=\"text-[10px] text-neutral-400 font-sans-clean leading-snug mb-2\" data-kid=\"76\">College infrastructure video tour embedded ahead.</div>\n          <div class=\"flex items-center gap-1.5 text-[9px] font-mono-tech uppercase text-neutral-400 group-hover:text-white transition-colors\" data-kid=\"77\">\n            <span data-kid=\"78\">Scan Spec</span>\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" class=\"transform group-hover:translate-x-1 transition-transform\" data-kid=\"79\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\" data-kid=\"80\"></line><polyline points=\"12 5 19 12 12 19\" data-kid=\"81\"></polyline></svg>\n          </div>\n        </div>\n\n        \n        <div class=\"absolute -top-12 -right-4 bg-gradient-to-r from-neutral-900 to-neutral-950 border border-white/10 px-4 py-3 rounded-lg shadow-2xl flex items-center gap-3 animate-float-gentle max-w-[180px]\" data-kid=\"82\">\n          <div class=\"w-6 h-6 flex items-center justify-center bg-[#bf4e30]/10 border border-[#bf4e30]/30 text-[#bf4e30] rounded-sm\" data-kid=\"83\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"84\"><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\" data-kid=\"85\"></path><polyline points=\"3.27 6.96 12 12.01 20.73 6.96\" data-kid=\"86\"></polyline><line x1=\"12\" y1=\"22.08\" x2=\"12\" y2=\"12\" data-kid=\"87\"></line></svg>\n          </div>\n          <div data-kid=\"88\">\n            <div class=\"text-[9px] font-mono-tech text-white uppercase tracking-wider\" data-kid=\"89\">3D GRAVITY</div>\n            <div class=\"text-[9px] font-mono-tech text-emerald-400\" data-kid=\"90\">ACTIVE STABILITY</div>\n          </div>\n        </div>\n\n      </div>\n\n    </div>\n\n    \n    <div class=\"flex items-center justify-between border-t border-white/5 pt-8 text-[10px] font-mono-tech text