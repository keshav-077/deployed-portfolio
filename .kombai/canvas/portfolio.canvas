      "html": "\n<div class=\"bg-[#1D2A35] text-white font-inter overflow-x-hidden selection:bg-[#E04F3E] selection:text-white\" data-kid=\"0\">\n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Syncopate:wght@400;700&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        :root {\n            --primary: #E04F3E;\n            --secondary: #5C8F9E;\n            --bg-dark: #1D2A35;\n            --terminal: #0d151c;\n        }\n\n        .font-syncopate { font-family: 'Syncopate', sans-serif; }\n        .font-inter { font-family: 'Inter', sans-serif; }\n\n        /* Floating Container Styles */\n        .container-box {\n            background-color: var(--primary);\n            position: absolute;\n            box-shadow: \n                inset -8px -8px 16px rgba(0,0,0,0.4),\n                inset 8px 8px 16px rgba(255,255,255,0.1),\n                10px 10px 40px rgba(0,0,0,0.5);\n            background-image: repeating-linear-gradient(90deg, transparent, transparent 4px, rgba(0,0,0,0.06) 4px, rgba(0,0,0,0.06) 8px);\n            border: 1px solid rgba(255,255,255,0.05);\n            transform-style: preserve-3d;\n        }\n\n        .container-box.blue { background-color: #3b82f6; }\n        .container-box.teal { background-color: var(--secondary); }\n\n        @keyframes float-slow {\n            0%, 100% { transform: translateY(0) rotate(0deg) translateZ(0); }\n            50% { transform: translateY(-40px) rotate(1.5deg) translateZ(20px); }\n        }\n\n        @keyframes float-fast {\n            0%, 100% { transform: translateY(0) rotate(0deg); }\n            50% { transform: translateY(-20px) rotate(-1.5deg); }\n        }\n\n        .animate-float-slow { animation: float-slow 15s ease-in-out infinite; }\n        .animate-float-fast { animation: float-fast 10s ease-in-out infinite; }\n\n        /* Glassmorphism */\n        .glass-panel {\n            background: rgba(29, 42, 53, 0.6);\n            backdrop-filter: blur(16px);\n            border: 1px solid rgba(255, 255, 255, 0.1);\n            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);\n        }\n\n        /* Stencil Text */\n        .stencil-text {\n            -webkit-text-stroke: 1px rgba(255,255,255,0.3);\n            color: transparent;\n            font-family: 'Syncopate', sans-serif;\n            text-transform: uppercase;\n        }\n\n        /* Laser Line */\n        .laser-line {\n            background: linear-gradient(180deg, rgba(224, 79, 62, 0) 0%, #E04F3E 50%, rgba(224, 79, 62, 0) 100%);\n            box-shadow: 0 0 15px rgba(224, 79, 62, 0.8), 0 0 30px rgba(224, 79, 62, 0.4);\n        }\n\n        /* Terminal styling */\n        .terminal-bg {\n            background-color: #0d151c;\n            background-image: radial-gradient(circle at center, rgba(224, 79, 62, 0.05) 0%, transparent 70%);\n        }\n\n        .custom-scrollbar::-webkit-scrollbar {\n            width: 4px;\n        }\n        .custom-scrollbar::-webkit-scrollbar-track {\n            background: #1D2A35;\n        }\n        .custom-scrollbar::-webkit-scrollbar-thumb {\n            background: #E04F3E;\n        }\n    </style>\n\n    \n    <nav class=\"absolute top-0 w-full z-50 flex justify-between items-center px-12 py-8 bg-transparent\" data-kid=\"2\">\n        <div class=\"font-syncopate text-xl font-bold tracking-tighter flex items-center gap-2\" data-kid=\"3\">\n            <span class=\"w-8 h-8 bg-[#E04F3E] flex items-center justify-center text-xs\" data-kid=\"4\">KM</span>\n            <span data-kid=\"5\">MAKIREDDI</span>\n        </div>\n        <div class=\"hidden md:flex gap-12 font-syncopate text-[10px] tracking-[0.3em] font-bold opacity-70\" data-kid=\"6\">\n            <span class=\"cursor-default hover:text-[#E04F3E] transition-colors\" data-kid=\"7\">ABOUT</span>\n            <span class=\"cursor-default hover:text-[#E04F3E] transition-colors\" data-kid=\"8\">EXPERIENCE</span>\n            <span class=\"cursor-default hover:text-[#E04F3E] transition-colors\" data-kid=\"9\">PROJECTS</span>\n            <span class=\"cursor-default hover:text-[#E04F3E] transition-colors\" data-kid=\"10\">TERMINAL</span>\n        </div>\n    </nav>\n\n    \n    <section class=\"relative h-[950px] w-full overflow-hidden\" data-kid=\"11\">\n        \n        <div class=\"absolute inset-0 z-0\" data-kid=\"12\">\n            <img src=\"https://images.pexels.com/photos/733171/pexels-photo-733171.jpeg?auto=compress&cs=tinysrgb&w=1600&q=80\" class=\"w-full h-full object-cover grayscale brightness-40 contrast-125\" alt=\"Mountain Sunrise\" decoding=\"async\" loading=\"lazy\" data-kid=\"13\">\n            <div class=\"absolute inset-0 bg-gradient-to-t from-[#1D2A35] via-transparent to-transparent\" data-kid=\"14\"></div>\n            <div class=\"absolute inset-0 bg-[#5C8F9E]/15 mix-blend-color\" data-kid=\"15\"></div>\n        </div>\n\n        \n        <div class=\"absolute inset-0 z-10 pointer-events-none perspective-[1000px]\" data-kid=\"16\">\n            \n            <div class=\"container-box w-32 h-14 top-[15%] left-[20%] opacity-40 blur-xs animate-float-slow\" style=\"animation-delay: -1s;\" data-kid=\"17\"></div>\n            <div class=\"container-box teal w-24 h-10 top-[40%] left-[5%] opacity-30 blur-sm animate-float-fast\" style=\"animation-delay: -3s;\" data-kid=\"18\"></div>\n            <div class=\"container-box w-40 h-18 top-[10%] right-[15%] opacity-40 blur-xs animate-float-slow\" style=\"animation-delay: -5s;\" data-kid=\"19\"></div>\n            \n            \n            <div class=\"container-box blue w-56 h-24 top-[50%] right-[10%] opacity-60 animate-float-slow\" style=\"animation-delay: -2s;\" data-kid=\"20\"></div>\n            <div class=\"container-box w-48 h-20 bottom-[25%] left-[15%] opacity-90 animate-float-fast\" style=\"animation-delay: -4s;\" data-kid=\"21\"></div>\n            \n            \n            <div class=\"container-box w-80 h-36 bottom-[8%] right-[20%] opacity-100 animate-float-slow shadow-2xl\" data-kid=\"22\"></div>\n            <div class=\"container-box teal w-64 h-28 top-[20%] right-[5%] opacity-80 animate-float-fast shadow-xl\" data-kid=\"23\"></div>\n        </div>\n\n        \n        <div class=\"relative z-20 flex flex-col items-center justify-center h-full px-6 text-center\" data-kid=\"24\">\n            <div class=\"mb-6 inline-block px-4 py-1 border border-[#E04F3E]/50 bg-[#E04F3E]/10 font-syncopate text-[9px] tracking-[0.5em] text-[#E04F3E] rounded-full uppercase\" data-kid=\"25\">\n                AI / ML Systems Architect\n            </div>\n            <h1 class=\"font-syncopate text-5xl md:text-7xl lg:text-8xl font-bold text-white tracking-[0.15em] leading-tight mb-8 transition-all duration-700\" data-kid=\"26\">\n                KESHAVARDHAN<br data-kid=\"27\">MAKIREDDI\n            </h1>\n            <p class=\"font-inter text-base md:text-xl text-white/60 tracking-[0.3em] uppercase font-light max-w-4xl\" data-kid=\"28\">\n                Architecting The Invisible Supply Chain\n            </p>\n            \n            <div class=\"mt-16 group cursor-pointer flex flex-col items-center gap-4\" data-kid=\"29\">\n                <span class=\"font-syncopate text-[9px] tracking-[0.4em] opacity-40 group-hover:opacity-100 transition-opacity\" data-kid=\"30\">SCROLL TO ANALYZE</span>\n                <div class=\"w-px h-24 bg-gradient-to-b from-[#E04F3E] to-transparent\" data-kid=\"31\"></div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"about\" class=\"relative py-32 px-12 md:px-24 bg-gradient-to-b from-[#1D2A35] to-[#121c24]\" data-kid=\"32\">\n        <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row items-center gap-20\" data-kid=\"33\">\n            \n            <div class=\"w-full md:w-1/2 glass-panel p-10 md:p-16 relative overflow-hidden group\" data-kid=\"34\">\n                <div class=\"absolute top-0 left-0 w-2 h-full bg-[#E04F3E]\" data-kid=\"35\"></div>\n                <div class=\"stencil-text text-6xl absolute -top-4 -right-4 opacity-5\" data-kid=\"36\">ARCHITECT</div>\n                \n                <h2 class=\"font-syncopate text-3xl mb-8 tracking-widest text-[#E04F3E]\" data-kid=\"37\">SYSTEM OVERVIEW</h2>\n                <div class=\"space-y-6 font-inter text-lg leading-relaxed text-white/80\" data-kid=\"38\">\n                    <p data-kid=\"39\">\n                        I specialize in designing the <span class=\"text-white font-bold\" data-kid=\"40\">Invisible Supply Chain</span> — where high-dimensional data meets physical orchestration. \n                    </p>\n                    <p data-kid=\"41\">\n                        My expertise lies at the intersection of <span class=\"text-[#E04F3E]\" data-kid=\"42\">Large Language Models (LLMs)</span>, retrieval-augmented systems <span class=\"text-[#E04F3E]\" data-kid=\"43\">(RAG)</span>, and high-performance <span class=\"text-[#E04F3E]\" data-kid=\"44\">Computer Vision</span>. \n                    </p>\n                    <p class=\"text-white/60 text-base\" data-kid=\"45\">\n                        By treating digital logistics as a living neural network, I build autonomous systems that predict demand, optimize transit, and visualize complexity at a planetary scale.\n                    </p>\n                </div>\n\n                <div class=\"mt-10 flex gap-6 items-center\" data-kid=\"46\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"47\">\n                        <i class=\"ti ti-cpu text-[#E04F3E] text-2xl\" data-kid=\"48\"></i>\n                        <span class=\"font-syncopate text-[10px] tracking-widest\" data-kid=\"49\">AI NATIVE</span>\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"50\">\n                        <i class=\"ti ti-network text-cyan-400 text-2xl\" data-kid=\"51\"></i>\n                        <span class=\"font-syncopate text-[10px] tracking-widest\" data-kid=\"52\">LOGISTICS OPT</span>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div class=\"w-full md:w-1/2 relative h-[600px] flex items-center justify-center\" data-kid=\"53\">\n                <div class=\"relative w-full h-full flex flex-wrap justify-center items-center gap-6\" data-kid=\"54\">\n                    \n                    <div class=\"grid grid-cols-2 gap-6 transform rotate-6 hover:rotate-0 transition-all duration-1000 perspective-[1000px]\" data-kid=\"55\">\n                        <div class=\"w-32 h-32 bg-[#E04F3E] shadow-[0_20px_50px_rgba(224,79,62,0.3)] animate-float-slow relative group overflow-hidden border border-white/10\" data-kid=\"56\">\n                            <div class=\"absolute inset-0 bg-white/10 opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"57\"></div>\n                            <img src=\"https://images.unsplash.com/photo-1625014618427-fbc980b974f5?auto=format&w=300&q=80&fit=crop\" class=\"w-full h-full object-cover opacity-30 group-hover:opacity-60 transition-opacity\" alt=\"Cube\" decoding=\"async\" loading=\"lazy\" data-kid=\"58\">\n                        </div>\n                        <div class=\"w-44 h-44 bg-zinc-900 shadow-2xl animate-float-fast relative group overflow-hidden border border-white/5\" style=\"animation-delay: -1s;\" data-kid=\"59\">\n                            <img src=\"https://images.unsplash.com/photo-1622737133809-d95047b9e673?auto=format&w=400&q=80&fit=crop\" class=\"w-full h-full object-cover opacity-20\" alt=\"Cube\" decoding=\"async\" loading=\"lazy\" data-kid=\"60\">\n                            <div class=\"absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"61\">\n                                <i class=\"ti ti-activity text-white/40 text-4xl\" data-kid=\"62\"></i>\n                            </div>\n                        </div>\n                        <div class=\"w-36 h-36 bg-[#5C8F9E] shadow-2xl animate-float-slow relative group overflow-hidden border border-white/10\" style=\"animation-delay: -2s;\" data-kid=\"63\">\n                            <div class=\"absolute inset-0 border-4 border-white/5\" data-kid=\"64\"></div>\n                            <div class=\"absolute inset-0 flex items-center justify-center\" data-kid=\"65\">\n                                <i class=\"ti ti-box text-white/30 text-5xl\" data-kid=\"66\"></i>\n                            </div>\n                        </div>\n                        <div class=\"w-40 h-40 bg-white/5 backdrop-blur-xl border border-white/20 shadow-2xl animate-float-fast flex items-center justify-center\" style=\"animation-delay: -3.5s;\" data-kid=\"67\">\n                            <div class=\"w-20 h-20 border border-white/20 animate-spin\" style=\"animation-duration: 10s;\" data-kid=\"68\"></div>\n                        </div>\n                    </div>\n                    \n                    <div class=\"absolute top-[40%] left-0 w-full h-[2px] bg-gradient-to-r from-transparent via-[#E04F3E] to-transparent blur-[2px] opacity-40\" data-kid=\"69\"></div>\n                    <div class=\"absolute top-0 left-[60%] w-[1px] h-full bg-gradient-to-b from-transparent via-cyan-400 to-transparent blur-[1px] opacity-30\" data-kid=\"70\"></div>\n                    <div class=\"absolute bottom-[20%] right-[10%] w-24 h-24 rounded-full bg-cyan-500/10 blur-3xl animate-pulse\" data-kid=\"71\"></div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"experience\" class=\"py-40 bg-[#1D2A35]\" data-kid=\"72\">\n        <div class=\"max-w-5xl mx-auto px-6\" data-kid=\"73\">\n            <div class=\"text-center mb-32\" data-kid=\"74\">\n                <h2 class=\"font-syncopate text-4xl font-bold tracking-[0.3em] mb-4\" data-kid=\"75\">SUPPLY CHAIN NODES</h2>\n                <p class=\"font-inter text-[#E04F3E] tracking-[0.2em] text-xs uppercase font-bold\" data-kid=\"76\">Operational History</p>\n            </div>\n\n            <div class=\"relative min-h-[700px]\" data-kid=\"77\">\n                \n                <div class=\"absolute left-1/2 -translate-x-1/2 top-0 bottom-0 w-[2px] laser-line opacity-90\" data-kid=\"78\"></div>\n                <div class=\"absolute left-1/2 -translate-x-1/2 top-0 bottom-0 w-[8px] laser-line opacity-20 blur-md\" data-kid=\"79\"></div>\n\n                \n                <div class=\"space-y-32\" data-kid=\"80\">\n                    \n                    <div class=\"flex items-center justify-between w-full\" data-kid=\"81\">\n                        <div class=\"w-[45%] text-right pr-12 hidden md:block\" data-kid=\"82\">\n                            <div class=\"font-syncopate text-[10px] tracking-widest text-white/30\" data-kid=\"83\">CURRENT DEPLOYMENT</div>\n                            <div class=\"font-inter text-2xl font-bold text-white/20 mt-2 tracking-tighter\" data-kid=\"84\">2024 / Q3</div>\n                        </div>\n                        <div class=\"relative z-10 w-6 h-6 rounded-full bg-[#E04F3E] border-4 border-[#1D2A35] shadow-[0_0_20px_#E04F3E]\" data-kid=\"85\"></div>\n                        <div class=\"w-full md:w-[45%] md:pl-12\" data-kid=\"86\">\n                            <div class=\"container-box !relative w-full p-10 group hover:translate-x-4 transition-all duration-500 shadow-2xl\" data-kid=\"87\">\n                                <div class=\"stencil-text text-5xl absolute -top-4 -left-4 opacity-10\" data-kid=\"88\">01</div>\n                                <h3 class=\"font-syncopate text-2xl mb-1 text-white\" data-kid=\"89\">C5i</h3>\n                                <p class=\"text-[10px] font-syncopate tracking-[0.3em] text-white/60 mb-6 uppercase\" data-kid=\"90\">AI/ML Research Intern</p>\n                                <p class=\"font-inter text-base text-white/90 leading-relaxed\" data-kid=\"91\">\n                                    Engineering next-gen enterprise RAG systems and multimodal LLM agents for predictive supply chain orchestration.\n                                </p>\n                                <div class=\"mt-6 flex gap-3\" data-kid=\"92\">\n                                    <div class=\"w-2 h-2 rounded-full bg-white/20 animate-pulse\" data-kid=\"93\"></div>\n                                    <div class=\"w-2 h-2 rounded-full bg-white/20 animate-pulse\" style=\"animation-delay: 0.2s;\" data-kid=\"94\"></div>\n                                    <div class=\"w-2 h-2 rounded-full bg-white/20 animate-pulse\" style=\"animation-delay: 0.4s;\" data-kid=\"95\"></div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"flex items-center justify-between w-full flex-row-reverse\" data-kid=\"96\">\n                        <div class=\"w-[45%] text-left pl-12 hidden md:block\" data-kid=\"97\">\n                            <div class=\"font-syncopate text-[10px] tracking-widest text-white/30\" data-kid=\"98\">FISCAL 2023</div>\n                            <div class=\"font-inter text-2xl font-bold text-white/20 mt-2 tracking-tighter\" data-kid=\"99\">2023 / Q1</div>\n                        </div>\n                        <div class=\"relative z-10 w-6 h-6 rounded-full bg-[#5C8F9E] border-4 border-[#1D2A35] shadow-[0_0_20px_#5C8F9E]\" data-kid=\"100\"></div>\n                        <div class=\"w-full md:w-[45%] md:pr-12\" data-kid=\"101\">\n                            <div class=\"bg-zinc-900 !relative w-full p-10 border-r-8 border-[#5C8F9E] group hover:-translate-x-4 transition-all duration-500 shadow-2xl\" data-kid=\"102\">\n                                <div class=\"stencil-text text-5xl absolute -top-4 -right-4 opacity-10\" data-kid=\"103\">02</div>\n                                <h3 class=\"font-syncopate text-2xl mb-1 text-white\" data-kid=\"104\">INFOTECK</h3>\n                                <p class=\"text-[10px] font-syncopate tracking-[0.3em] text-white/60 mb-6 uppercase\" data-kid=\"105\">Computer Vision Dev</p>\n                                <p class=\"font-inter text-base text-white/90 leading-relaxed\" data-kid=\"106\">\n                                    Developed high-performance asset tracking using YOLOv8. Optimized neural pipelines for edge-based industrial automation.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"flex items-center justify-between w-full\" data-kid=\"107\">\n                        <div class=\"w-[45%] text-right pr-12 hidden md:block\" data-kid=\"108\">\n                            <div class=\"font-syncopate text-[10px] tracking-widest text-white/30\" data-kid=\"109\">ACADEMIC ORIGIN</div>\n                            <div class=\"font-inter text-2xl font-bold text-white/20 mt-2 tracking-tighter\" data-kid=\"110\">2020 / START</div>\n                        </div>\n                        <div class=\"relative z-10 w-6 h-6 rounded-full bg-zinc-600 border-4 border-[#1D2A35] shadow-[0_0_20px_#71717a]\" data-kid=\"111\"></div>\n                        <div class=\"w-full md:w-[45%] md:pl-12\" data-kid=\"112\">\n                            <div class=\"bg-zinc-800/40 backdrop-blur-md !relative w-full p-10 border-l-8 border-zinc-600 group hover:translate-x-4 transition-all duration-500\" data-kid=\"113\">\n                                <div class=\"stencil-text text-5xl absolute -top-4 -left-4 opacity-10\" data-kid=\"114\">03</div>\n                                <h3 class=\"font-syncopate text-2xl mb-1 text-white\" data-kid=\"115\">IIIT NAGPUR</h3>\n                                <p class=\"text-[10px] font-syncopate tracking-[0.3em] text-white/60 mb-6 uppercase\" data-kid=\"116\">Research Scholar</p>\n                                <p class=\"font-inter text-base text-white/90 leading-relaxed\" data-kid=\"117\">\n                                    Focused on deep learning fundamentals and neural architecture search in constrained logistics environments.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"projects\" class=\"py-32 bg-[#121c24] relative overflow-hidden\" data-kid=\"118\">\n        <div class=\"absolute inset-0 pointer-events-none opacity-20\" data-kid=\"119\">\n            <div class=\"container-box w-20 h-10 top-10 right-20 rotate-12\" data-kid=\"120\"></div>\n            <div class=\"container-box w-16 h-8 bottom-40 left-10 -rotate-6\" data-kid=\"121\"></div>\n        </div>\n\n        <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"122\">\n            <div class=\"flex justify-between items-end mb-16\" data-kid=\"123\">\n                <div data-kid=\"124\">\n                    <h2 class=\"font-syncopate text-4xl font-bold tracking-[0.3em] mb-4\" data-kid=\"125\">CARGO MANIFEST</h2>\n                    <p class=\"font-inter text-[#E04F3E] tracking-[0.3em] text-xs uppercase font-bold\" data-kid=\"126\">Selected Projects</p>\n                </div>\n                <div class=\"hidden md:block font-syncopate text-[9px] tracking-[0.4em] opacity-40\" data-kid=\"127\">SYSTEM STATUS: OPTIMIZED</div>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-10\" data-kid=\"128\">\n                \n                <div class=\"group relative bg-[#1D2A35] p-8 border border-white/5 transition-all duration-500 hover:border-[#E04F3E]/50 overflow-hidden\" data-kid=\"129\">\n                    <div class=\"absolute -top-10 -right-10 stencil-text text-8xl opacity-5 group-hover:opacity-10 transition-opacity\" data-kid=\"130\">01</div>\n                    <div class=\"h-48 w-full mb-8 overflow-hidden\" data-kid=\"131\">\n                        <img src=\"https://images.pexels.com/photos/17483873/pexels-photo-17483873.png?auto=compress&cs=tinysrgb&w=600&q=80\" class=\"w-full h-full object-cover grayscale transition-all duration-700 group-hover:grayscale-0 group-hover:scale-110\" alt=\"Project\" decoding=\"async\" loading=\"lazy\" data-kid=\"132\">\n                    </div>\n                    <div class=\"font-syncopate text-xs text-[#E04F3E] tracking-widest mb-2\" data-kid=\"133\">PROJ-001 / AI</div>\n                    <h3 class=\"font-syncopate text-xl mb-4 text-white group-hover:text-[#E04F3E] transition-colors\" data-kid=\"134\">NEURAL LOGISTICS</h3>\n                    <p class=\"font-inter text-sm text-white/60 leading-relaxed mb-6\" data-kid=\"135\">\n                        Distributed agentic workflow for supply chain demand forecasting using RAG-enabled LLMs.\n                    </p>\n                    <div class=\"flex flex-wrap gap-2\" data-kid=\"136\">\n                        <span class=\"px-2 py-1 text-[8px] font-bold tracking-widest border border-cyan-400 text-cyan-400 rounded-sm\" data-kid=\"137\">PYTORCH</span>\n                        <span class=\"px-2 py-1 text-[8px] font-bold tracking-widest border border-cyan-400 text-cyan-400 rounded-sm\" data-kid=\"138\">RAG</span>\n                    </div>\n                </div>\n\n                \n                <div class=\"group relative bg-[#1D2A35] p-8 border border-white/5 transition-all duration-500 hover:border-[#E04F3E]/50 overflow-hidden\" data-kid=\"139\">\n                    <div class=\"absolute -top-10 -right-10 stencil-text text-8xl opacity-5 group-hover:opacity-10 transition-opacity\" data-kid=\"140\">02</div>\n                    <div class=\"h-48 w-full mb-8 overflow-hidden\" data-kid=\"141\">\n                        <img src=\"https://images.pexels.com/photos/18069814/pexels-photo-18069814.png?auto=compress&cs=tinysrgb&w=600&q=80\" class=\"w-full h-full object-cover grayscale transition-all duration-700 group-hover:grayscale-0 group-hover:scale-110\" alt=\"Project\" decoding=\"async\" loading=\"lazy\" data-kid=\"142\">\n                    </div>\n                    <div class=\"font-syncopate text-xs text-[#E04F3E] tracking-widest mb-2\" data-kid=\"143\">PROJ-002 / CV</div>\n                    <h3 class=\"font-syncopate text-xl mb-4 text-white group-hover:text-[#E04F3E] transition-colors\" data-kid=\"144\">VISION FLEET</h3>\n                    <p class=\"font-inter text-sm text-white/60 leading-relaxed mb-6\" data-kid=\"145\">\n                        Autonomous fleet tracking system with real-time pose estimation and container ID recognition.\n                    </p>\n                    <div class=\"flex flex-wrap gap-2\" data-kid=\"146\">\n                        <span class=\"px-2 py-1 text-[8px] font-bold tracking-widest border border-cyan-400 text-cyan-400 rounded-sm\" data-kid=\"147\">OPENCV</span>\n                        <span class=\"px-2 py-1 text-[8px] font-bold tracking-widest border border-cyan-400 text-cyan-400 rounded-sm\" data-kid=\"148\">CUDA</span>\n                    </div>\n                </div>\n\n                \n                <div class=\"group relative bg-[#1D2A35] p-8 border border-white/5 transition-all duration-500 hover:border-[#E04F3E]/50 overflow-hidden\" data-kid=\"149\">\n                    <div class=\"absolute -top-10 -right-10 stencil-text text-8xl opacity-5 group-hover:opacity-10 transition-opacity\" data-kid=\"150\">03</div>\n                    <div class=\"h-48 w-full mb-8 overflow-hidden\" data-kid=\"151\">\n                        <img src=\"https://images.pexels.com/photos/30547618/pexels-photo-30547618.jpeg?auto=compress&cs=tinysrgb&w=600&q=80\" class=\"w-full h-full object-cover grayscale transition-all duration-700 group-hover:grayscale-0 group-hover:scale-110\" alt=\"Project\" decoding=\"async\" loading=\"lazy\" data-kid=\"152\">\n                    </div>\n                    <div class=\"font-syncopate text-xs text-[#E04F3E] tracking-widest mb-2\" data-kid=\"153\">PROJ-003 / DATA</div>\n                    <h3 class=\"font-syncopate text-xl mb-4 text-white group-hover:text-[#E04F3E] transition-colors\" data-kid=\"154\">SILENT STREAM</h3>\n                    <p class=\"font-inter text-sm text-white/60 leading-relaxed mb-6\" data-kid=\"155\">\n                        Ultra-low latency data distribution network modeled after global shipping lanes.\n                    </p>\n                    <div class=\"flex flex-wrap gap-2\" data-kid=\"156\">\n                        <span class=\"px-2 py-1 text-[8px] font-bold tracking-widest border border-cyan-400 text-cyan-400 rounded-sm\" data-kid=\"157\">GOLANG</span>\n                        <span class=\"px-2 py-1 text-[8px] font-bold tracking-widest border border-cyan-400 text-cyan-400 rounded-sm\" data-kid=\"158\">GRPC</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"py-40 bg-[#1D2A35]\" data-kid=\"159\">\n        <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"160\">\n            <h2 class=\"font-syncopate text-4xl font-bold tracking-[0.3em] mb-24 text-center\" data-kid=\"161\">STACK ARCHITECTURE</h2>\n            \n            <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-6\" data-kid=\"162\">\n                \n                <div class=\"container-box !relative h-40 flex flex-col items-center justify-center p-6 hover:scale-105 transition-transform cursor-crosshair group shadow-xl\" data-kid=\"163\">\n                    <i class=\"ti ti-brand-python text-4xl mb-3 opacity-60 group-hover:opacity-100 transition-opacity\" data-kid=\"164\"></i>\n                    <span class=\"font-syncopate text-[10px] tracking-[0.3em] font-bold\" data-kid=\"165\">PYTHON</span>\n                </div>\n                \n                <div class=\"bg-zinc-800 border border-white/5 !relative h-40 flex flex-col items-center justify-center p-6 hover:scale-105 transition-transform cursor-crosshair group shadow-xl\" data-kid=\"166\">\n                    <i class=\"ti ti-brain text-4xl mb-3 text-[#E04F3E] opacity-60 group-hover:opacity-100 transition-opacity\" data-kid=\"167\"></i>\n                    <span class=\"font-syncopate text-[10px] tracking-[0.3em] font-bold text-white/80\" data-kid=\"168\">PYTORCH</span>\n                </div>\n                \n                <div class=\"container-box !relative h-40 flex flex-col items-center justify-center p-6 hover:scale-105 transition-transform cursor-crosshair group shadow-xl\" data-kid=\"169\">\n                    <i class=\"ti ti-device-laptop text-4xl mb-3 opacity-60 group-hover:opacity-100 transition-opacity\" data-kid=\"170\"></i>\n                    <span class=\"font-syncopate text-[10px] tracking-[0.3em] font-bold\" data-kid=\"171\">CUDA</span>\n                </div>\n                \n                <div class=\"bg-zinc-800 border border-white/5 !relative h-40 flex flex-col items-center justify-center p-6 hover:scale-105 transition-transform cursor-crosshair group shadow-xl\" data-kid=\"172\">\n                    <i class=\"ti ti-database text-4xl mb-3 text-cyan-400 opacity-60 group-hover:opacity-100 transition-opacity\" data-kid=\"173\"></i>\n                    <span class=\"font-syncopate text-[10px] tracking-[0.3em] font-bold text-white/80\" data-kid=\"174\">SQL / NO-SQL</span>\n                </div>\n                \n                <div class=\"bg-zinc-900 border-2 border-[#E04F3E] !relative h-40 flex flex-col items-center justify-center p-6 hover:scale-105 transition-transform cursor-crosshair group shadow-2xl\" data-kid=\"175\">\n                    <i class=\"ti ti-robot text-4xl mb-3 text-[#E04F3E]\" data-kid=\"176\"></i>\n                    <span class=\"font-syncopate text-[10px] tracking-[0.2em] font-bold text-[#E04F3E] text-center\" data-kid=\"177\">RAG / LLM AGENTS</span>\n                </div>\n                \n                <div class=\"bg-zinc-800 border border-white/5 !relative h-40 flex flex-col items-center justify-center p-6 hover:scale-105 transition-transform cursor-crosshair group shadow-xl\" data-kid=\"178\">\n                    <i class=\"ti ti-brand-docker text-4xl mb-3 opacity-60 group-hover:opacity-100 transition-opacity\" data-kid=\"179\"></i>\n                    <span class=\"font-syncopate text-[10px] tracking-[0.3em] font-bold text-white/80\" data-kid=\"180\">DOCKER</span>\n                </div>\n                \n                <div class=\"container-box !relative h-40 flex flex-col items-center justify-center p-6 hover:scale-105 transition-transform cursor-crosshair group shadow-xl\" data-kid=\"181\">\n                    <i class=\"ti ti-server text-4xl mb-3 opacity-60 group-hover:opacity-100 transition-opacity\" data-kid=\"182\"></i>\n                    <span class=\"font-syncopate text-[10px] tracking-[0.3em] font-bold\" data-kid=\"183\">KUBERNETES</span>\n                </div>\n                \n                <div class=\"bg-zinc-800 border border-white/5 !relative h-40 flex flex-col items-center justify-center p-6 hover:scale-105 transition-transform cursor-crosshair group shadow-xl\" data-kid=\"184\">\n                    <i class=\"ti ti-camera text-4xl mb-3 opacity-60 group-hover:opacity-100 transition-opacity\" data-kid=\"185\"></i>\n                    <span class=\"font-syncopate text-[10px] tracking-[0.3em] font-bold text-white/80\" data-kid=\"186\">COMPUTER VISION</span>\n                </div>\n                \n                <div class=\"container-box !relative h-40 flex flex-col items-center justify-center p-6 hover:scale-105 transition-transform cursor-crosshair group shadow-xl\" data-kid=\"187\">\n                    <i class=\"ti ti-cloud text-4xl mb-3 opacity-60 group-hover:opacity-100 transition-opacity\" data-kid=\"188\"></i>\n                    <span class=\"font-syncopate text-[10px] tracking-[0.3em] font-bold\" data-kid=\"189\">CLOUD NATIVE</span>\n                </div>\n                \n                <div class=\"bg-zinc-800 border border-white/5 !relative h-40 flex flex-col items-center justify-center p-6 hover:scale-105 transition-transform cursor-crosshair group shadow-xl\" data-kid=\"190\">\n                    <i class=\"ti ti-brand-git text-4xl mb-3 opacity-60 group-hover:opacity-100 transition-opacity text-orange-400\" data-kid=\"191\"></i>\n                    <span class=\"font-syncopate text-[10px] tracking-[0.3em] font-bold text-white/80\" data-kid=\"192\">GIT / CI/CD</span>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"contact\" class=\"py-32 terminal-bg relative border-t border-white/5\" data-kid=\"193\">\n        <div class=\"max-w-4xl mx-auto px-6\" data-kid=\"194\">\n            <div class=\"glass-panel p-8 md:p-12 relative\" data-kid=\"195\">\n                <div class=\"flex items-center gap-4 mb-8 border-b border-white/10 pb-4\" data-kid=\"196\">\n                    <div class=\"flex gap-2\" data-kid=\"197\">\n                        <div class=\"w-3 h-3 rounded-full bg-[#E04F3E]\" data-kid=\"198\"></div>\n                        <div class=\"w-3 h-3 rounded-full bg-zinc-700\" data-kid=\"199\"></div>\n                        <div class=\"w-3 h-3 rounded-full bg-zinc-700\" data-kid=\"200\"></div>\n                    </div>\n                    <div class=\"font-syncopate text-[10px] tracking-[0.3em] opacity-40 uppercase\" data-kid=\"201\">TERMINAL v2.0 // ESTABLISH CONNECTION</div>\n                </div>\n\n                <div class=\"space-y-8\" data-kid=\"202\">\n                    <div class=\"flex flex-col md:flex-row gap-8\" data-kid=\"203\">\n                        <div class=\"flex-1 space-y-2\" data-kid=\"204\">\n                            <label class=\"font-syncopate text-[9px] tracking-widest text-white/40 block\" data-kid=\"205\">IDENTIFIER NAME</label>\n                            <input type=\"text\" class=\"w-full bg-black/40 border border-white/10 p-4 font-inter text-sm focus:border-[#E04F3E] outline-hidden transition-colors\" placeholder=\"ENTER NAME...\" data-kid=\"206\">\n                        </div>\n                        <div class=\"flex-1 space-y-2\" data-kid=\"207\">\n                            <label class=\"font-syncopate text-[9px] tracking-widest text-white/40 block\" data-kid=\"208\">ENCRYPTION EMAIL</label>\n                            <input type=\"email\" class=\"w-full bg-black/40 border border-white/10 p-4 font-inter text-sm focus:border-[#E04F3E] outline-hidden transition-colors\" placeholder=\"USER@NETWORK.COM\" data-kid=\"209\">\n                        </div>\n                    </div>\n                    <div class=\"space-y-2\" data-kid=\"210\">\n                        <label class=\"font-syncopate text-[9px] tracking-widest text-white/40 block\" data-kid=\"211\">DATA PAYLOAD (MESSAGE)</label>\n                        <textarea class=\"w-full bg-black/60 border border-white/10 p-4 font-inter text-sm h-32 focus:border-[#E04F3E] outline-hidden transition-colors resize-none text-white/90\" placeholder=\"TRANSMIT YOUR INTENT...\" data-kid=\"212\"></textarea>\n                    </div>\n                    \n                    <button class=\"w-full bg-[#E04F3E] py-6 font-syncopate text-xs tracking-[0.5em] font-bold hover:bg-[#E04F3E]/80 transition-all flex items-center justify-center gap-4 group\" data-kid=\"213\">\n                        TRANSMIT DATA\n                        <i class=\"ti ti-arrow-right transition-transform group-hover:translate-x-2\" data-kid=\"214\"></i>\n                    </button>\n                </div>\n            </div>\n            \n            <div class=\"mt-20 flex flex-col md:flex-row justify-between items-center gap-8 border-t border-white/5 pt-12\" data-kid=\"215\">\n                <div class=\"flex gap-8\" data-kid=\"216\">\n                    <a href=\"#\" class=\"text-white/40 hover:text-[#E04F3E] transition-colors\" data-kid=\"217\"><i class=\"ti ti-brand-github text-2xl\" data-kid=\"218\"></i></a>\n                    <a href=\"#\" class=\"text-white/40 hover:text-[#E04F3E] transition-colors\" data-kid=\"219\"><i class=\"ti ti-brand-linkedin text-2xl\" data-kid=\"220\"></i></a>\n                    <a href=\"#\" class=\"text-white/40 hover:text-[#E04F3E] transition-colors\" data-kid=\"221\"><i class=\"ti ti-brand-x text-2xl\" data-kid=\"222\"></i></a>\n                </div>\n                <div class=\"font-syncopate text-[9px] tracking-[0.4em] opacity-40\" data-kid=\"223\">\n                    &copy; 2024 KESHAVARDHAN MAKIREDDI / PLANETARY SCALE LOGISTICS\n                </div>\n            </div>\n        </div>\n    </section>\n</div>\n",
