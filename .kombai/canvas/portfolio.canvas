      "html": "<div class=\"relative w-full min-h-[900px] bg-[#050b14] text-[#d1dce5] font-mono overflow-hidden\" data-kid=\"0\">\n  \n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;700&family=Share+Tech+Mono&family=Plus+Jakarta+Sans:wght@300;400;600&display=swap');\n    \n    .font-brutal-wide {\n      font-family: 'Space Grotesk', sans-serif;\n      font-weight: 700;\n    }\n    .font-mono-raw {\n      font-family: 'Share Tech Mono', monospace;\n    }\n    .font-sans-clean {\n      font-family: 'Plus Jakarta Sans', sans-serif;\n    }\n\n    /* Floating keyframes with distinct offsets for suspended gravity */\n    @keyframes sway-container-1 {\n      0%, 100% { transform: translateY(0px) rotate(1deg); }\n      50% { transform: translateY(-15px) rotate(-1deg); }\n    }\n    @keyframes sway-container-2 {\n      0%, 100% { transform: translateY(0px) rotate(-0.5deg); }\n      50% { transform: translateY(-8px) rotate(0.5deg); }\n    }\n    @keyframes sway-container-3 {\n      0%, 100% { transform: translateY(0px) rotate(0.2deg); }\n      50% { transform: translateY(-12px) rotate(-0.2deg); }\n    }\n    .animate-sway-1 {\n      animation: sway-container-1 7s ease-in-out infinite;\n    }\n    .animate-sway-2 {\n      animation: sway-container-2 5s ease-in-out infinite;\n    }\n    .animate-sway-3 {\n      animation: sway-container-3 9s ease-in-out infinite;\n    }\n  </style>\n\n  \n  <div class=\"absolute inset-0 z-0\" data-kid=\"2\">\n    <img src=\"/api/local/images/public/screenshot-2.png\" alt=\"Misty mountains with suspended shipping containers\" decoding=\"async\" loading=\"lazy\" class=\"w-full h-full object-cover opacity-20 filter contrast-125 saturate-50\" data-kid=\"3\">\n    <div class=\"absolute inset-0 bg-gradient-to-b from-[#050b14] via-[#050b14]/50 to-[#050b14]\" data-kid=\"4\"></div>\n    <div class=\"absolute inset-0 bg-gradient-to-r from-[#050b14] via-transparent to-[#050b14]\" data-kid=\"5\"></div>\n  </div>\n\n  \n  <div class=\"absolute inset-0 z-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:16px_16px] opacity-15\" data-kid=\"6\"></div>\n  \n  \n  <svg class=\"absolute inset-0 w-full h-full z-10 pointer-events-none opacity-30\" xmlns=\"http://www.w3.org/2000/svg\" data-kid=\"7\">\n    <line x1=\"150\" y1=\"0\" x2=\"150\" y2=\"450\" stroke=\"#bf4e30\" stroke-width=\"1\" stroke-dasharray=\"4,4\" data-kid=\"8\"></line>\n    <line x1=\"880\" y1=\"0\" x2=\"880\" y2=\"280\" stroke=\"#3b82f6\" stroke-width=\"1\" data-kid=\"9\"></line>\n    <line x1=\"1120\" y1=\"0\" x2=\"1120\" y2=\"380\" stroke=\"#cba36d\" stroke-width=\"1\" stroke-dasharray=\"2,2\" data-kid=\"10\"></line>\n  </svg>\n\n  \n  <div class=\"relative z-20 max-w-7xl mx-auto px-8 pt-6 pb-20 flex flex-col justify-between min-h-[900px]\" data-kid=\"11\">\n    \n    \n    <header class=\"flex items-center justify-between border border-white/10 bg-[#050b14]/80 backdrop-blur-md px-6 py-4 rounded-md\" data-kid=\"12\">\n      <div class=\"flex items-center gap-3\" data-kid=\"13\">\n        <div class=\"w-5 h-5 bg-[#bf4e30] flex items-center justify-center text-black font-bold text-xs\" data-kid=\"14\">H</div>\n        <span class=\"text-sm font-bold tracking-widest text-white uppercase font-brutal-wide\" data-kid=\"15\">HAPPY_ROBOT.EXE</span>\n      </div>\n      \n      <nav class=\"hidden lg:flex items-center gap-6 text-[10px] tracking-wider uppercase font-mono-raw text-neutral-400\" data-kid=\"16\">\n        <a href=\"#education\" class=\"hover:text-[#bf4e30] transition-colors\" data-kid=\"17\">[01] EDUCATION</a>\n        <a href=\"#experience\" class=\"hover:text-[#bf4e30] transition-colors\" data-kid=\"18\">[02] EXPERIENCE</a>\n        <a href=\"#projects\" class=\"hover:text-[#bf4e30] transition-colors\" data-kid=\"19\">[03] PROJECTS</a>\n        <a href=\"#publications\" class=\"hover:text-[#bf4e30] transition-colors\" data-kid=\"20\">[04] PUBLICATIONS</a>\n        <a href=\"#skills\" class=\"hover:text-[#bf4e30] transition-colors\" data-kid=\"21\">[05] SKILLS</a>\n      </nav>\n\n      <div class=\"flex items-center gap-3\" data-kid=\"22\">\n        <span class=\"text-[9px] text-[#bf4e30] font-mono-raw animate-pulse\" data-kid=\"23\">LINK_STABLE</span>\n        <div class=\"w-2.5 h-2.5 rounded-full bg-emerald-500\" data-kid=\"24\"></div>\n      </div>\n    </header>\n\n    \n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center my-auto py-8\" data-kid=\"25\">\n      \n      \n      <div class=\"lg:col-span-5 space-y-6\" data-kid=\"26\">\n        <div class=\"inline-block px-3 py-1 bg-white/5 border border-white/10 text-[#bf4e30] text-[10px] font-mono-raw tracking-widest uppercase\" data-kid=\"27\">\n          PROJECT REVELATION: PHASE_01\n        </div>\n        \n        <h1 class=\"text-5xl md:text-6xl tracking-tight text-white font-brutal-wide leading-none uppercase\" data-kid=\"28\">\n          UNRESTRICTED <br data-kid=\"29\">\n          <span class=\"text-transparent bg-clip-text bg-gradient-to-r from-[#bf4e30] to-[#e8b258]\" data-kid=\"30\">3D LOGISTICS</span>\n        </h1>\n        \n        <p class=\"text-neutral-400 text-xs md:text-sm font-sans-clean leading-relaxed max-w-md\" data-kid=\"31\">\n          A brutalist spatial ecosystem engineered for supply-chain designers, digital mechanics, and high-fidelity showcase structures. Suspension algorithms active.\n        </p>\n\n        <div class=\"p-4 border-l-2 border-[#bf4e30] bg-white/5 backdrop-blur-sm max-w-sm rounded-r\" data-kid=\"32\">\n          <div class=\"text-[9px] font-mono-raw text-[#bf4e30] mb-1\" data-kid=\"33\">SYSTEM_FEED_LOG:</div>\n          <div class=\"text-[11px] text-neutral-300 font-sans-clean\" data-kid=\"34\">College infrastructure video rendering engine connected inside section block (02).</div>\n        </div>\n\n        <div class=\"flex items-center gap-4 pt-4\" data-kid=\"35\">\n          <a href=\"#interact\" class=\"px-6 py-3.5 bg-[#bf4e30] hover:bg-[#bf4e30]/85 text-black font-bold text-xs tracking-wider uppercase transition-all duration-200 shadow-[0_5px_15px_rgba(191,78,48,0.3)]\" data-kid=\"36\">\n            INITIALIZE GRAVITY\n          </a>\n          <a href=\"#experience\" class=\"px-6 py-3.5 border border-white/10 hover:border-white/30 hover:bg-white/5 text-white text-xs tracking-wider uppercase transition-all duration-200\" data-kid=\"37\">\n            EXPERIENCE DECK\n          </a>\n        </div>\n      </div>\n\n      \n      <div class=\"lg:col-span-7 relative h-[480px] flex items-center justify-center\" data-kid=\"38\">\n        \n        \n        <div class=\"absolute right-4 top-4 w-[85%] aspect-[16/10] bg-[#0c1322] border border-white/10 rounded p-3 shadow-2xl animate-sway-1 z-10 hover:border-[#bf4e30]/40 transition-colors\" data-kid=\"39\">\n          <div class=\"flex items-center justify-between border-b border-white/5 pb-2 mb-2 text-[8px] text-neutral-400\" data-kid=\"40\">\n            <span data-kid=\"41\">VESSEL_MANIFEST // AD-0249</span>\n            <span class=\"text-amber-500 font-bold\" data-kid=\"42\">CARGO ACTIVE</span>\n          </div>\n          <div class=\"relative w-full h-[calc(100%-25px)] bg-black rounded overflow-hidden\" data-kid=\"43\">\n            <video src=\"https://videos.pexels.com/video-files/26893767/12028834_640_360_24fps.mp4\" poster=\"https://images.pexels.com/videos/26893767/pexels-photo-26893767.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-full object-cover grayscale brightness-90 filter contrast-110\" data-kid=\"44\"></video>\n            <div class=\"absolute inset-0 bg-[#050b14]/40 mix-blend-overlay\" data-kid=\"45\"></div>\n            \n            <div class=\"absolute inset-0 flex items-center justify-center pointer-events-none opacity-40\" data-kid=\"46\">\n              <i class=\"ti ti-crosshair text-white text-4xl\" data-kid=\"47\"></i>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"absolute left-4 bottom-2 w-[55%] bg-[#08101e] border-t-2 border-[#bf4e30] border-x border-b border-white/10 rounded p-4 shadow-3xl animate-sway-2 z-20\" data-kid=\"48\">\n          <div class=\"text-[9px] text-[#bf4e30] uppercase mb-1 font-mono-raw\" data-kid=\"49\">// SUSPENDED_METRIC_01</div>\n          <div class=\"text-3xl font-brutal-wide text-white leading-tight mb-2\" data-kid=\"50\">99.8%</div>\n          <div class=\"text-[10px] text-neutral-400 font-sans-clean leading-normal\" data-kid=\"51\">\n            Precision delivery latency on supply chain AI coordination routing protocols.\n          </div>\n          \n          <div class=\"flex items-center justify-between border-t border-white/5 pt-2 mt-2 text-[8px] text-neutral-500\" data-kid=\"52\">\n            <span data-kid=\"53\">SECTOR: OAKLAND_O2</span>\n            <span data-kid=\"54\">STATUS: OPTIMAL</span>\n          </div>\n        </div>\n\n        \n        <div class=\"absolute right-0 bottom-12 w-[160px] bg-[#bf4e30]/10 backdrop-blur-md border border-[#bf4e30]/30 rounded p-3 animate-sway-3 z-30\" data-kid=\"55\">\n          <div class=\"flex items-center gap-2 mb-1.5\" data-kid=\"56\">\n            <span class=\"w-2 h-2 bg-[#bf4e30] animate-ping rounded-full\" data-kid=\"57\"></span>\n            <span class=\"text-[8px] text-white font-mono-raw\" data-kid=\"58\">ALERT_SYSTEM</span>\n          </div>\n          <p class=\"text-[9px] text-neutral-300 font-sans-clean leading-relaxed\" data-kid=\"59\">\n            Automatic multi-redirect transitions configured. Click panel to pivot canvas camera.\n          </p>\n        </div>\n\n      </div>\n\n    </div>\n\n    \n    <div class=\"border-t border-white/10 pt-6 flex flex-wrap items-center justify-between gap-4 text-[9px] font-mono-raw text-neutral-500\" data-kid=\"60\">\n      <div class=\"flex items-center gap-4\" data-kid=\"61\">\n        <span data-kid=\"62\">GRID_LOCK: SH-1002</span>\n        <span data-kid=\"63\">•</span>\n        <span data-kid=\"64\">LATENCY: 4.8MS</span>\n        <span data-kid=\"65\">•</span>\n        <span data-kid=\"66\">LOCATION_COORDS: OAKLAND_PORT_TERMINAL_5</span>\n      </div>\n      <div class=\"text-neutral-400\" data-kid=\"67\">\n        [ SYSTEM RUNNING OPTIMAL : PORTFOLIO_LAUNCH_SEQUENCE ]\n      </div>\n    </div>\n\n  </div>\n</div>",
