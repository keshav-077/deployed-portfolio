ter p-12 relative\" data-kid=\"30\">\n            <div class=\"max-w-7xl w-full grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\" data-kid=\"31\">\n                <div class=\"space-y-8\" data-kid=\"32\">\n                    <div class=\"inline-flex items-center gap-2 px-3 py-1 bg-cyan-500/10 border border-cyan-500/30 text-[10px] tracking-widest font-bold\" data-kid=\"33\">\n                        <span class=\"w-2 h-2 bg-cyan-500 animate-pulse rounded-full\" data-kid=\"34\"></span>\n                        SYSTEM_AUTH_GRANTED: K.MAKIREDDI\n                    </div>\n                    \n                    <div class=\"space-y-0 leading-[0.85] crt-flicker\" data-kid=\"35\">\n                        <h1 class=\"text-7xl lg:text-8xl font-bold font-['Space_Grotesk'] text-white glitch tracking-tighter\" data-text=\"KESHAVARDHAN\" data-kid=\"36\">KESHAVARDHAN</h1>\n                        <h1 class=\"text-7xl lg:text-8xl font-bold font-['Space_Grotesk'] text-white glitch tracking-tighter\" data-text=\"MAKIREDDI\" data-kid=\"37\">MAKIREDDI</h1>\n                    </div>\n\n                    <div class=\"flex items-center gap-4 text-2xl lg:text-3xl text-cyan-400 font-light border-l-4 border-cyan-500 pl-6\" data-kid=\"38\">\n                        <span data-kid=\"39\">> DEEP TECH ARCHITECT</span>\n                        <span class=\"w-1 h-10 bg-cyan-500 animate-[blink_1s_infinite]\" data-kid=\"40\"></span>\n                    </div>\n\n                    <p class=\"max-w-xl text-gray-400 leading-relaxed text-sm lg:text-base\" data-kid=\"41\">\n                        Engineering the next generation of autonomous cyber-logistics. From neural trade routes to sharded supply architectures, I build the invisible systems that power global movement.\n                    </p>\n\n                    <div class=\"flex gap-6 pt-6\" data-kid=\"42\">\n                        <button class=\"px-10 py-4 bg-cyan-500 text-black font-bold uppercase tracking-widest skew-x-