      "html": "\n<div class=\"bg-[#F4F1EA] text-black font-['Work_Sans'] selection:bg-[#C85A17] selection:text-white overflow-x-hidden\" data-kid=\"0\">\n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Work+Sans:wght@300;400;500;600;700&display=swap');\n        \n        :root {\n            --paper: #F4F1EA;\n            --accent-orange: #C85A17;\n            --accent-green: #1E3F33;\n            --accent-blue: #4A6A82;\n            --shadow-black: 10px 10px 0px 0px rgba(0,0,0,1);\n            --shadow-sm: 4px 4px 0px 0px rgba(0,0,0,1);\n        }\n\n        .font-bebas { font-family: 'Bebas Neue', cursive; }\n        .brutalist-shadow { box-shadow: var(--shadow-black); }\n        .brutalist-shadow-sm { box-shadow: var(--shadow-sm); }\n        \n        .marquee { animation: marquee 30s linear infinite; }\n        @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }\n\n        .isometric-plane { transform: perspective(1200px) rotateX(10deg) rotateY(-10deg); }\n        \n        .blueprint-grid {\n            background-image: radial-gradient(circle, #000 1px, transparent 1px);\n            background-size: 40px 40px;\n        }\n\n        .diagonal-bg {\n            clip-path: polygon(0 0, 100% 0, 100% 100%, 40% 100%);\n        }\n\n        .stenciled-label {\n            @apply border-2 border-black px-2 py-0.5 font-bebas text-sm uppercase tracking-wider;\n        }\n\n        .tech-manual-cols {\n            column-count: 1;\n        }\n        @media (min-width: 768px) {\n            .tech-manual-cols { column-count: 2; column-gap: 4rem; }\n        }\n\n        .invoice-table th, .invoice-table td {\n            @apply border-2 border-black p-4 text-left;\n        }\n        .invoice-table th {\n            @apply bg-[#1E3F33] text-white font-bebas text-xl tracking-widest;\n        }\n    </style>\n\n    \n    <nav class=\"absolute top-0 left-0 w-full z-50 bg-[#F4F1EA] border-b-4 border-black px-8 py-6 flex justify-between items-center\" data-kid=\"2\">\n        <div class=\"flex items-center gap-4\" data-kid=\"3\">\n            <span class=\"text-3xl font-bebas tracking-tighter border-4 border-black px-3 py-1 bg-white brutalist-shadow-sm\" data-kid=\"4\">ARCH_LOG_01</span>\n            <span class=\"hidden md:block text-xs font-mono uppercase opacity-50\" data-kid=\"5\">Blueprint for the Future // REV. 2024.1</span>\n        </div>\n        <div class=\"flex gap-8 font-bebas text-xl\" data-kid=\"6\">\n            <span class=\"px-2 border-b-2 border-transparent hover:border-black cursor-default transition-all\" data-kid=\"7\">FOUNDATION</span>\n            <span class=\"px-2 border-b-2 border-transparent hover:border-black cursor-default transition-all\" data-kid=\"8\">MANIFEST</span>\n            <span class=\"px-2 border-b-2 border-transparent hover:border-black cursor-default transition-all\" data-kid=\"9\">UNITS</span>\n            <span class=\"px-2 border-b-2 border-transparent hover:border-black cursor-default transition-all\" data-kid=\"10\">DISPATCH</span>\n        </div>\n    </nav>\n\n    \n    <header class=\"relative min-h-[850px] flex border-b-4 border-black pt-20\" data-kid=\"11\">\n        \n        <div class=\"w-full lg:w-3/5 p-12 lg:p-24 flex flex-col justify-center relative z-10 bg-[#F4F1EA]\" data-kid=\"12\">\n            <div class=\"space-y-[-1.5rem] lg:space-y-[-3rem]\" data-kid=\"13\">\n                <div class=\"flex items-center gap-4 mb-4\" data-kid=\"14\">\n                    <span class=\"stenciled-label bg-black text-white\" data-kid=\"15\">SUBJECT: ENGINEER</span>\n                    <span class=\"text-xs font-mono opacity-40 tracking-widest\" data-kid=\"16\">ARCHITECTING THE INVISIBLE</span>\n                </div>\n                <h1 class=\"text-[10rem] lg:text-[18rem] font-bebas leading-[0.8] text-black m-0\" data-kid=\"17\">AI</h1>\n                <h1 class=\"text-[10rem] lg:text-[18rem] font-bebas leading-[0.8] text-[#C85A17] m-0\" data-kid=\"18\">ML</h1>\n                <h1 class=\"text-[10rem] lg:text-[18rem] font-bebas leading-[0.8] text-black m-0\" data-kid=\"19\">LOGISTICS</h1>\n            </div>\n            <div class=\"mt-12 max-w-lg border-4 border-black p-8 bg-white brutalist-shadow relative\" data-kid=\"20\">\n                <div class=\"absolute -top-4 -left-4 bg-black text-white px-2 py-1 font-bebas\" data-kid=\"21\">CORE_MISSION</div>\n                <p class=\"text-2xl font-bold uppercase leading-tight italic\" data-kid=\"22\">\n                    Designing the autonomous digital infrastructure that orchestrates global movement.\n                </p>\n                <div class=\"mt-6 flex gap-4\" data-kid=\"23\">\n                    <button class=\"bg-black text-white font-bebas px-6 py-2 text-xl hover:bg-[#C85A17] transition-colors cursor-pointer brutalist-shadow-sm\" data-kid=\"24\">VIEW_UNITS</button>\n                    <button class=\"border-2 border-black font-bebas px-6 py-2 text-xl hover:bg-black hover:text-white transition-colors cursor-pointer\" data-kid=\"25\">REQUEST_ACCESS</button>\n                </div>\n            </div>\n        </div>\n\n        \n        <div class=\"hidden lg:block absolute inset-0 left-3/5 bg-[#4A6A82] diagonal-bg border-l-4 border-black overflow-hidden\" data-kid=\"26\">\n            <div class=\"blueprint-grid absolute inset-0 opacity-20\" data-kid=\"27\"></div>\n            <div class=\"absolute inset-0 flex items-center justify-center p-24\" data-kid=\"28\">\n                <div class=\"relative w-full aspect-square border-8 border-black brutalist-shadow bg-white p-4\" data-kid=\"29\">\n                    <img src=\"https://images.unsplash.com/photo-1741958193874-6ef299f6b053?auto=format&w=1200&q=80&fit=crop\" alt=\"Isometric Supply Chain Architecture\" class=\"w-full h-full object-cover grayscale contrast-125\" decoding=\"async\" loading=\"lazy\" data-kid=\"30\">\n                    <div class=\"absolute bottom-4 right-4 bg-black text-white px-4 py-2 font-bebas text-lg\" data-kid=\"31\">FIG. 001: SUPPLY NETWORK TOPOGRAPHY</div>\n                </div>\n            </div>\n            \n            <div class=\"absolute top-20 right-20 text-white/50 font-mono text-xs text-right leading-relaxed\" data-kid=\"32\">\n                COORDINATE_SYSTEM: ISOMETRIC_V2<br data-kid=\"33\">\n                PROJECTION: ORTHOGRAPHIC<br data-kid=\"34\">\n                DENSITY: 0.85_LOG<br data-kid=\"35\">\n                FLOW_STATE: OPTIMIZED\n            </div>\n        </div>\n    </header>\n\n    \n    <section id=\"about\" class=\"py-32 border-b-4 border-black bg-white relative overflow-hidden\" data-kid=\"36\">\n        \n        <svg class=\"absolute top-0 left-0 w-full h-full pointer-events-none opacity-[0.03]\" xmlns=\"http://www.w3.org/2000/svg\" data-kid=\"37\">\n            <line x1=\"10%\" y1=\"0\" x2=\"10%\" y2=\"100%\" stroke=\"black\" stroke-width=\"2\" data-kid=\"38\"></line>\n            <line x1=\"0\" y1=\"20%\" x2=\"100%\" y2=\"20%\" stroke=\"black\" stroke-width=\"2\" data-kid=\"39\"></line>\n            <circle cx=\"10%\" cy=\"20%\" r=\"8\" fill=\"black\" data-kid=\"40\"></circle>\n            <path d=\"M 10% 40% L 90% 40% L 90% 80% L 10% 80% Z\" fill=\"none\" stroke=\"black\" stroke-width=\"1\" stroke-dasharray=\"10,5\" data-kid=\"41\"></path>\n        </svg>\n\n        <div class=\"max-w-7xl mx-auto px-8 relative z-10\" data-kid=\"42\">\n            <div class=\"flex flex-col lg:flex-row gap-16 items-start\" data-kid=\"43\">\n                <div class=\"lg:w-1/3\" data-kid=\"44\">\n                    <h2 class=\"text-8xl lg:text-9xl font-bebas leading-[0.8] mb-8\" data-kid=\"45\">FOUNDATION</h2>\n                    <div class=\"border-4 border-black p-6 bg-[#F4F1EA] brutalist-shadow-sm space-y-4\" data-kid=\"46\">\n                        <div class=\"text-sm font-mono flex justify-between\" data-kid=\"47\">\n                            <span data-kid=\"48\">SPECIFICATION:</span>\n                            <span class=\"font-bold\" data-kid=\"49\">BIO_DATA</span>\n                        </div>\n                        <div class=\"text-sm font-mono flex justify-between\" data-kid=\"50\">\n                            <span data-kid=\"51\">REVISION:</span>\n                            <span class=\"font-bold\" data-kid=\"52\">v2.4.0</span>\n                        </div>\n                        <div class=\"text-sm font-mono flex justify-between border-t-2 border-black pt-4\" data-kid=\"53\">\n                            <span data-kid=\"54\">STATUS:</span>\n                            <span class=\"text-green-600 font-bold uppercase tracking-widest\" data-kid=\"55\">Online</span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"lg:w-2/3 tech-manual-cols\" data-kid=\"56\">\n                    <style data-kid=\"57\">\n                        .drop-cap { float: left; font-family: 'Bebas Neue'; font-size: 7rem; line-height: 0.8; margin-right: 1rem; color: white; background: black; padding: 0.5rem 1.25rem; margin-top: 0.25rem; border: 4px solid #C85A17; display: flex; align-items: center; justify-content: center; box-shadow: 4px 4px 0px 0px rgba(0,0,0,1); }\n                    </style>\n                    <p class=\"text-xl leading-relaxed mb-8 text-justify font-medium pt-2\" data-kid=\"58\">\n                        <span class=\"drop-cap\" data-kid=\"59\">A</span>\n                        rchitecting the future requires more than code; it demands a deep understanding of the structural underpinnings that keep our world moving. As an AI Engineer specializing in Global Logistics, I build the \"Invisible Supply Chain\"—the hidden digital layer that orchestrates the flow of goods across continents.\n                    </p>\n                    <p class=\"text-xl leading-relaxed mb-8 text-justify\" data-kid=\"60\">\n                        My work transforms industrial chaos into structural minimalism. From temporal graph networks that predict global shipping bottlenecks to autonomous vision systems for real-time terminal management, I treat every logistical challenge as a modular blueprint waiting to be refined.\n                    </p>\n                    <div class=\"bg-[#1E3F33] text-white p-8 mb-8 brutalist-shadow-sm\" data-kid=\"61\">\n                        <h4 class=\"font-bebas text-3xl mb-4 border-b-2 border-white/20 pb-2\" data-kid=\"62\">CORE_PARAMETERS</h4>\n                        <ul class=\"font-mono text-sm space-y-3\" data-kid=\"63\">\n                            <li class=\"flex items-center gap-3\" data-kid=\"64\">\n                                <span class=\"w-4 h-4 bg-[#C85A17] inline-block\" data-kid=\"65\"></span>\n                                NEURAL_NETWORK_OPTIMIZATION\n                            </li>\n                            <li class=\"flex items-center gap-3\" data-kid=\"66\">\n                                <span class=\"w-4 h-4 bg-[#C85A17] inline-block\" data-kid=\"67\"></span>\n                                AUTONOMOUS_INFRASTRUCTURE\n                            </li>\n                            <li class=\"flex items-center gap-3\" data-kid=\"68\">\n                                <span class=\"w-4 h-4 bg-[#C85A17] inline-block\" data-kid=\"69\"></span>\n                                PREDICTIVE_LOGISTICS_FLOW\n                            </li>\n                        </ul>\n                    </div>\n                    <p class=\"text-xl leading-relaxed text-justify\" data-kid=\"70\">\n                        Every system is a node. Every node is a variable. My mission is to design the constants—the robust foundations that ensure resilient trade in an unpredictable world. I don't just solve for today; I engineer for the next decade of autonomous commerce.\n                    </p>\n                </div>\n            </div>\n        </div>\n        \n        <div class=\"absolute bottom-0 right-0 w-1/3 h-1/3 opacity-5 pointer-events-none\" data-kid=\"71\">\n            <svg width=\"100%\" height=\"100%\" viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\" data-kid=\"72\">\n                <line x1=\"0\" y1=\"100\" x2=\"100\" y2=\"0\" stroke=\"black\" stroke-width=\"0.5\" data-kid=\"73\"></line>\n                <line x1=\"20\" y1=\"100\" x2=\"100\" y2=\"20\" stroke=\"black\" stroke-width=\"0.5\" data-kid=\"74\"></line>\n                <line x1=\"40\" y1=\"100\" x2=\"100\" y2=\"40\" stroke=\"black\" stroke-width=\"0.5\" data-kid=\"75\"></line>\n                <line x1=\"0\" y1=\"80\" x2=\"80\" y2=\"0\" stroke=\"black\" stroke-width=\"0.5\" data-kid=\"76\"></line>\n            </svg>\n        </div>\n    </section>\n\n    \n    <section id=\"experience\" class=\"py-32 bg-[#F4F1EA] border-b-4 border-black\" data-kid=\"77\">\n        <div class=\"max-w-7xl mx-auto px-8\" data-kid=\"78\">\n            <div class=\"flex items-end justify-between mb-16 border-b-8 border-black pb-8\" data-kid=\"79\">\n                <div data-kid=\"80\">\n                    <h2 class=\"text-8xl lg:text-9xl font-bebas leading-[0.8]\" data-kid=\"81\">EXPERIENCE MANIFEST</h2>\n                    <p class=\"mt-4 font-mono text-sm uppercase tracking-widest opacity-60\" data-kid=\"82\">Verified chronological deployment records</p>\n                </div>\n                <div class=\"hidden md:block\" data-kid=\"83\">\n                    <i class=\"ti ti-barcode text-9xl\" data-kid=\"84\"></i>\n                    <div class=\"text-right font-mono text-xs\" data-kid=\"85\">SC-VERIFIED-01</div>\n                </div>\n            </div>\n\n            <div class=\"bg-white border-4 border-black p-4 lg:p-12 brutalist-shadow relative overflow-hidden\" data-kid=\"86\">\n                <div class=\"flex flex-col md:flex-row justify-between mb-12 gap-8\" data-kid=\"87\">\n                    <div class=\"space-