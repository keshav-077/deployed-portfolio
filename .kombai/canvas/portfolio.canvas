   </div>\n                            <div class=\"grid grid-cols-2 gap-4 text-[9px] font-bold tracking-[0.2em] uppercase text-cyan-500/60 border-y border-white/5 py-4 group-hover:border-cyan-500/30 transition-colors\" data-kid=\"121\">\n                                <div class=\"flex flex-col gap-1\" data-kid=\"122\">\n                                    <span class=\"text-white/40\" data-kid=\"123\">LATENCY_RED</span>\n                                    <span class=\"text-cyan-400 terminal-glow\" data-kid=\"124\">0.42ms <i class=\"ti ti-arrow-down\" data-kid=\"125\"></i></span>\n                                </div>\n                                <div class=\"flex flex-col gap-1 text-right\" data-kid=\"126\">\n                                    <span class=\"text-white/40\" data-kid=\"127\">EFFICIENCY</span>\n                                    <span class=\"text-green-500\" data-kid=\"128\">+14% <i class=\"ti ti-chart-area-line\" data-kid=\"129\"></i></span>\n                                </div>\n                            </div>\n                            <p class=\"text-xs text-gray-400 leading-relaxed font-light\" data-kid=\"130\">\n                                Distributed neural mesh for cross-border freight optimization. Uses genetic algorithms for real-time autonomous pathfinding.\n                            </p>\n                            <button class=\"w-full py-4 border border-cyan-500/30 text-cyan-500 text-[10px] font-bold uppercase tracking-[0.3em] hover:bg-cyan-500 hover:text-black transition-all flex items-center justify-center gap-3\" data-kid=\"131\">\n                                EXECUTE_MODULE <i class=\"ti ti-terminal-2\" data-kid=\"132\"></i>\n                            </button>\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"bg-[#151822] border-t-4 border-orange-500 relative group overflow-hidden hover:shadow-[0_0_40px_rgba(255,92,0,0.15)] transition-all\" data-kid=\"133\">\n                        <div class=\"h-56 overflow-hidden relative\" data-kid=\"134\">\n                            <img src=\"https://images.pexels.com/photos/18069816/pexels-photo-18069816.png?auto=compress&cs=tinysrgb&w=800&q=80\" alt=\"Cronos Ledger\" class=\"w-full h-full object-cover grayscale brightness-50 group-hover:grayscale-0 group-hover:brightness-100 transition-all duration-700 scale-110 group-hover:scale-100\" decoding=\"async\" loading=\"lazy\" data-kid=\"135\">\n                            <div class=\"absolute inset-0 bg-gradient-to-t from-[#151822] via-[#151822]/20 to-transparent\" data-kid=\"136\"></div>\n                            <div class=\"absolute top-4 right-4 bg-orange-500 text-black text-[10px] font-bold px-3 py-1 skew-x-[-15deg]\" data-kid=\"137\">ENCRYPTED_v1.2</div>\n                        </div>\n                        <div class=\"p-8 space-y-6\" data-kid=\"138\">\n                            <div class=\"flex justify-between items-start\" data-kid=\"139\">\n                                <h3 class=\"text-2xl font-bold text-white font-['Space_Grotesk'] tracking-tight\" data-kid=\"140\">CRONOS_LEDGER</h3>\n                                <i class=\"ti ti-shield-lock text-orange-500/50 text-2xl\" data-kid=\"141\"></i>\n                            </div>\n                            <div class=\"grid grid-cols-2 gap-4 text-[9px] font-bold tracking-[0.2em] uppercase text-orange-500/60 border-y border-white/5 py-4\" data-kid=\"142\">\n                                <div class=\"flex flex-col gap-1\" data-kid=\"143\">\n                                    <span class=\"text-white/40\" data-kid=\"144\">SYNC_SPEED</span>\n                                    <span data-kid=\"145\">0.4ms</span>\n                                </div>\n                                <div class=\"flex flex-col gap-1 text-right\" data-kid=\"146\">\n                                    <span class=\"text-white/40\" data-kid=\"147\">SHARDS</span>\n                                    <span class=\"text-white\" data-kid=\"148\">1024_NODES</span>\n                                </div>\n                            </div>\n                            <p class=\"text-xs text-gray-400 leading-relaxed font-light\" data-kid=\"149\">\n                                Immutable supply chain transparency layer. Sharded blockchain protocol for zero-knowledge freight verification.\n                            </p>\n                            <button class=\"w-full py-4 border border-orange-500/30 text-orange-500 text-[10px] font-bold uppercase tracking-[0.3em] hover:bg-orange-500 hover:text-black transition-all flex items-center justify-center gap-3\" data-kid=\"150\">\n                                EXECUTE_MODULE <i class=\"ti ti-terminal-2\" data-kid=\"151\"></i>\n                            </button>\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"bg-[#151822] border-t-4 border-green-500 relative group overflow-hidden hover:shadow-[0_0_40px_rgba(57,255,20,0.15)] transition-all\" data-kid=\"152\">\n                        <div class=\"h-56 overflow-hidden relative\" data-kid=\"153\">\n                            <img src=\"https://images.pexels.com/photos/17483870/pexels-photo-17483870.png?auto=compress&cs=tinysrgb&w=800&q=80\" alt=\"Aether Flow\" class=\"w-full h-full object-cover grayscale brightness-50 group-hover:grayscale-0 group-hover:brightness-100 transition-all duration-700 scale-110 group-hover:scale-100\" decoding=\"async\" loading=\"lazy\" data-kid=\"154\">\n                            <div class=\"absolute inset-0 bg-gradient-to-t from-[#151822] via-[#151822]/20 to-transparent\" data-kid=\"155\"></div>\n                            <div class=\"absolute top-4 right-4 bg-green-500 text-black text-[10px] font-bold px-3 py-1 skew-x-[-15deg]\" data-kid=\"156\">BETA_TEST_v3.1</div>\n                        </div>\n                        <div class=\"p-8 space-y-6\" data-kid=\"157\">\n                            <div class=\"flex justify-between items-start\" data-kid=\"158\">\n                                <h3 class=\"text-2xl font-bold text-white font-['Space_Grotesk'] tracking-tight\" data-kid=\"159\">AETHER_FLOW</h3>\n                                <i class=\"ti ti-drone text-green-500/50 text-2xl\" data-kid=\"160\"></i>\n                            </div>\n                            <div class=\"grid grid-cols-2 gap-4 text-[9px] font-bold tracking-[0.2em] uppercase text-green-500/60 border-y border-white/5 py-4\" data-kid=\"161\">\n                                <div class=\"flex flex-col gap-1\" data-kid=\"162\">\n                                    <span class=\"text-white/40\" data-kid=\"163\">AGENTS</span>\n                                    <span data-kid=\"164\">14,000+</span>\n                                </div>\n                                <div class=\"flex flex-col gap-1 text-right\" data-kid=\"165\">\n                                    <span class=\"text-white/40\" data-kid=\"166\">COLLISION</span>\n                                    <span class=\"text-white\" data-kid=\"167\">ZERO_TOL</span>\n                                </div>\n                            </div>\n                            <p class=\"text-xs text-gray-400 leading-relaxed font-light\" data-kid=\"168\">\n                                Predictive autonomous swarm coordination. Real-time fleet management for last-mile delivery protocols.\n                            </p>\n                            <button class=\"w-full py-4 border border-green-500/30 text-green-500 text-[10px] font-bold uppercase tracking-[0.3em] hover:bg-green-500 hover:text-black transition-all flex items-center justify-center gap-3\" data-kid=\"169\">\n                                EXECUTE_MODULE <i class=\"ti ti-terminal-2\" data-kid=\"170\"></i>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section id=\"skills\" class=\"py-32 px-12 relative overflow-hidden bg-black/40\" data-kid=\"171\">\n            <div class=\"max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-32\" data-kid=\"172\">\n                \n                \n                <div class=\"space-y-12 skill-matrix relative group/matrix\" data-kid=\"173\">\n                    <div class=\"space-y-2\" data-kid=\"174\">\n                        <div class=\"text-cyan-500 text-[10px] font-bold tracking-[0.5em] uppercase\" data-kid=\"175\">SYSTEM_CAPABILITY</div>\n                        <h2 class=\"text-4xl lg:text-5xl font-bold font-['Space_Grotesk'] text-white italic uppercase tracking-tighter\" data-kid=\"176\">\n                            Bandwidth_Matrix\n                        </h2>\n                    </div>\n\n                    \n                    <svg class=\"absolute inset-0 w-full h-full pointer-events-none z-0\" xmlns=\"http://www.w3.org/2000/svg\" data-kid=\"177\">\n                        <path class=\"connector-line\" d=\"M100,200 L300,200 L300,400\" stroke=\"var(--cyan)\" stroke-width=\"1\" fill=\"none\" data-kid=\"178\"></path>\n                        <path class=\"connector-line\" d=\"M200,100 L200,300 L400,300\" stroke=\"var(--orange)\" stroke-width=\"1\" fill=\"none\" data-kid=\"179\"></path>\n                        <path class=\"connector-line\" d=\"M400,100 L100,400\" stroke=\"var(--green)\" stroke-width=\"1\" fill=\"none\" data-kid=\"180\"></path>\n                    </svg>\n\n                    <div class=\"grid grid-cols-4 gap-4 relative z-10\" data-kid=\"181\">\n                        \n                        <div class=\"aspect-square border border-cyan-500/20 bg-[#151822] flex flex-col items-center justify-center gap-3 group/cell hover:border-cyan-500 hover:bg-cyan-500/10 transition-all cursor-crosshair\" data-kid=\"182\">\n               