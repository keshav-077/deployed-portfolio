      "html": "\n<div class=\"bg-[#0B0D17] text-[#00F0FF] font-['JetBrains_Mono'] selection:bg-[#00F0FF] selection:text-[#0B0D17] relative min-h-[3500px]\" data-kid=\"0\">\n    \n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;500;700&family=JetBrains+Mono:wght@300;400;500;700&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        :root {\n            --cyan: #00F0FF;\n            --orange: #FF5C00;\n            --green: #39FF14;\n            --dark: #0B0D17;\n            --panel: #151822;\n        }\n\n        /* Scanline Overlay */\n        .scanlines::before {\n            content: \" \";\n            display: block;\n            position: absolute;\n            top: 0;\n            left: 0;\n            bottom: 0;\n            right: 0;\n            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 255, 0, 0.06));\n            z-index: 100;\n            background-size: 100% 4px, 3px 100%;\n            pointer-events: none;\n            opacity: 0.15;\n        }\n\n        /* Glitch Effect */\n        .glitch {\n            position: relative;\n        }\n        .glitch::before, .glitch::after {\n            content: attr(data-text);\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n        }\n        .glitch::before {\n            left: 2px;\n            text-shadow: -2px 0 var(--cyan);\n            clip: rect(44px, 450px, 56px, 0);\n            animation: glitch-anim 5s infinite linear alternate-reverse;\n        }\n        .glitch::after {\n            left: -2px;\n            text-shadow: -2px 0 var(--orange), 2px 2px var(--cyan);\n            animation: glitch-anim2 1s infinite linear alternate-reverse;\n        }\n\n        @keyframes glitch-anim {\n            0% { clip: rect(82px, 9999px, 98px, 0); transform: skew(0.65deg); }\n            5% { clip: rect(12px, 9999px, 45px, 0); transform: skew(0.2deg); }\n            10% { clip: rect(67px, 9999px, 88px, 0); transform: skew(0.85deg); }\n            15% { clip: rect(44px, 9999px, 56px, 0); transform: skew(0.1deg); }\n            20% { clip: rect(90px, 9999px, 100px, 0); transform: skew(0.5deg); }\n            25% { clip: rect(2px, 9999px, 33px, 0); transform: skew(0.35deg); }\n            30% { clip: rect(55px, 9999px, 62px, 0); transform: skew(0.7deg); }\n            35% { clip: rect(18px, 9999px, 24px, 0); transform: skew(0.9deg); }\n            40% { clip: rect(8px, 9999px, 12px, 0); transform: skew(0.15deg); }\n            45% { clip: rect(33px, 9999px, 44px, 0); transform: skew(0.4deg); }\n            50% { clip: rect(78px, 9999px, 92px, 0); transform: skew(0.6deg); }\n            55% { clip: rect(22px, 9999px, 35px, 0); transform: skew(0.25deg); }\n            60% { clip: rect(61px, 9999px, 72px, 0); transform: skew(0.75deg); }\n            65% { clip: rect(49px, 9999px, 53px, 0); transform: skew(0.05deg); }\n            70% { clip: rect(85px, 9999px, 96px, 0); transform: skew(0.55deg); }\n            75% { clip: rect(11px, 9999px, 21px, 0); transform: skew(0.3deg); }\n            80% { clip: rect(58px, 9999px, 69px, 0); transform: skew(0.8deg); }\n            85% { clip: rect(37px, 9999px, 48px, 0); transform: skew(0.45deg); }\n            90% { clip: rect(72px, 9999px, 83px, 0); transform: skew(0.95deg); }\n            95% { clip: rect(5px, 9999px, 15px, 0); transform: skew(0.2deg); }\n            100% { clip: rect(82px, 9999px, 98px, 0); transform: skew(0.65deg); }\n        }\n        @keyframes glitch-anim2 {\n            0% { clip: rect(10px, 9999px, 50px, 0); transform: skew(0.1deg); }\n            100% { clip: rect(80px, 9999px, 100px, 0); transform: skew(0.9deg); }\n        }\n\n        .clip-hex {\n            clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);\n        }\n\n        .no-scrollbar::-webkit-scrollbar { display: none; }\n        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n\n        .terminal-glow {\n            text-shadow: 0 0 10px rgba(0, 240, 255, 0.5), 0 0 20px rgba(0, 240, 255, 0.2);\n        }\n\n        @keyframes flicker {\n            0% { opacity: 0.97; }\n            5% { opacity: 0.95; }\n            10% { opacity: 0.9; }\n            15% { opacity: 0.95; }\n            20% { opacity: 0.98; }\n            25% { opacity: 0.95; }\n            30% { opacity: 0.9; }\n            100% { opacity: 1; }\n        }\n\n        .crt-flicker {\n            animation: flicker 0.15s infinite;\n        }\n\n        @keyframes float {\n            0%, 100% { transform: translateY(0) rotate(0); }\n            50% { transform: translateY(-30px) rotate(15deg); }\n        }\n\n        @keyframes rotate-slow {\n            from { transform: rotate(0deg); }\n            to { transform: rotate(360deg); }\n        }\n\n        .floating-cube {\n            animation: float 8s ease-in-out infinite;\n        }\n        \n        .rotate-ui {\n            animation: rotate-slow 20s linear infinite;\n        }\n\n        /* SVG Line Animation */\n        .skill-matrix:hover .connector-line {\n            stroke-dashoffset: 0;\n            opacity: 0.4;\n        }\n        .connector-line {\n            stroke-dasharray: 1000;\n            stroke-dashoffset: 1000;\n            transition: all 1s ease-in-out;\n            opacity: 0;\n        }\n    </style>\n\n    \n    <div class=\"absolute inset-0 pointer-events-none z-0\" data-kid=\"2\">\n        \n        <div class=\"absolute inset-0 opacity-10\" style=\"background-image: linear-gradient(var(--cyan) 1px, transparent 1px), linear-gradient(90deg, var(--cyan) 1px, transparent 1px); background-size: 40px 40px;\" data-kid=\"3\"></div>\n        \n        <div class=\"absolute bottom-0 left-0 w-full h-[700px] opacity-25 mix-blend-screen overflow-hidden\" data-kid=\"4\">\n            <img src=\"https://images.unsplash.com/photo-1763571967192-06ea4eb3eded?auto=format&w=1600&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale invert contrast-[2] brightness-75\" decoding=\"async\" loading=\"lazy\" data-kid=\"5\">\n            <div class=\"absolute inset-0 bg-gradient-to-t from-[#0B0D17] via-transparent to-transparent\" data-kid=\"6\"></div>\n        </div>\n        \n        <div class=\"absolute top-40 left-20 w-32 h-32 opacity-20 floating-cube\" data-kid=\"7\">\n            <img src=\"https://images.pexels.com/photos/10194141/pexels-photo-10194141.jpeg?auto=compress&cs=tinysrgb&w=200&q=80\" class=\"w-full h-full object-contain rounded-lg border border-cyan-500/30\" decoding=\"async\" loading=\"lazy\" data-kid=\"8\">\n        </div>\n        <div class=\"absolute top-1/2 right-10 w-24 h-24 opacity-15 floating-cube\" style=\"animation-delay: -2s;\" data-kid=\"9\">\n            <img src=\"https://images.pexels.com/photos/28887851/pexels-photo-28887851.jpeg?auto=compress&cs=tinysrgb&w=200&q=80\" class=\"w-full h-full object-contain rounded-lg border border-orange-500/30\" decoding=\"async\" loading=\"lazy\" data-kid=\"10\">\n        </div>\n        <div class=\"absolute top-[2000px] left-[15%] w-40 h-40 opacity-10 floating-cube\" style=\"animation-delay: -4s;\" data-kid=\"11\">\n            <img src=\"https://images.pexels.com/photos/18069816/pexels-photo-18069816.png?auto=compress&cs=tinysrgb&w=300&q=80\" class=\"w-full h-full object-contain grayscale\" decoding=\"async\" loading=\"lazy\" data-kid=\"12\">\n        </div>\n    </div>\n\n    <div class=\"scanlines relative z-10\" data-kid=\"13\">\n        \n        <nav class=\"absolute top-0 w-full z-50 px-12 py-6 flex justify-between items-center backdrop-blur-md border-b border-cyan-500/10\" data-kid=\"14\">\n            <div class=\"flex items-center gap-3\" data-kid=\"15\">\n                <div class=\"w-10 h-1