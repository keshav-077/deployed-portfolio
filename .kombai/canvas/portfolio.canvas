19\">\n                                    <div class=\"absolute left-3 top-1/2 -translate-y-1/2 text-[10px] font-mono text-[#E04F3E] opacity-50 group-focus-within:opacity-100\" data-kid=\"220\">></div>\n                                    <input type=\"text\" placeholder=\"Your Name\" class=\"w-full bg-white/5 border border-white/10 p-4 pl-8 focus:border-[#E04F3E]/50 focus:bg-white/[0.08] outline-none text-white transition-all font-mono text-sm\" data-kid=\"221\">\n                                </div>\n                            </div>\n                            <div class=\"space-y-2\" data-kid=\"222\">\n                                <label class=\"text-[10px] font-mono text-slate-400 uppercase tracking-widest font-bold\" data-kid=\"223\">Protocol.Source</label>\n                                <div class=\"relative group\" data-kid=\"224\">\n                                    <div class=\"absolute left-3 top-1/2 -translate-y-1/2 text-[10px] font-mono text-[#E04F3E] opacity-50 group-focus-within:opacity-100\" data-kid=\"225\">></div>\n                                    <input type=\"email\" placeholder=\"Email Address\" class=\"w-full bg-white/5 border border-white/10 p-4 pl-8 focus:border-[#E04F3E]/50 focus:bg-white/[0.08] outline-none text-white transition-all font-mono text-sm\" data-kid=\"226\">\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"space-y-2\" data-kid=\"227\">\n                            <label class=\"text-[10px] font-mono text-slate-400 uppercase tracking-widest font-bold\" data-kid=\"228\">Protocol.Message_Payload</label>\n                            <div class=\"relative\" data-kid=\"229\">\n                                <textarea rows=\"4\" placeholder=\"Briefly describe the objective...\" class=\"w-full bg-white/5 border border-white/10 p-4 focus:border-[#E04F3E]/50 focus:bg-white/[0.08] outline-none text-white transition-all font-mono text-sm resize-none\" data-kid=\"230\"></textarea>\n                                <div class=\"absolute bottom-4 right-4 text-[8px] font-mono text-slate-600\" data-kid=\"231\">INPUT_READY</div>\n                            </div>\n                        </div>\n                        <button class=\"w-full py-4 bg-[#E04F3E] text-black font-bold font-syne uppercase tracking-[0.3em] hover:bg-white transition-colors flex items-center justify-center gap-3\" data-kid=\"232\">\n                            <span data-kid=\"233\">Initialize Upload</span>\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"234\"><line x1=\"22\" y1=\"2\" x2=\"11\" y2=\"13\" data-kid=\"235\"></line><polygon points=\"22 2 15 22 11 13 2 9 22 2\" data-kid=\"236\"></polygon></svg>\n                        </button>\n                    </form>\n                </div>\n            </div>\n        </section>\n    </main>\n\n    \n    <footer class=\"border-t border-white/5 bg-[#0A0F14] py-12 px-6\" data-kid=\"237\">\n        <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-8 relative\" data-kid=\"238\">\n            \n            <div class=\"absolute -top-6 left-0 w-full h-px bg-gradient-to-r from-transparent via-[#E04F3E]/20 to-transparent\" data-kid=\"239\"></div>\n            <div class=\"flex items-center gap-3\" data-kid=\"240\">\n                <div class=\"w-6 h-6 bg-[#E04F3E] flex items-center justify-center text-[10px] font-bold text-black\" data-kid=\"241\">KM</div>\n                <span class=\"text-[10px] font-mono text-slate-400 uppercase tracking-widest font-bold\" data-kid=\"242\">© 2024 Keshavardhan Makireddi // All Rights Reserved</span>\n            </div>\n            <div class=\"flex gap-8 text-[10px] font-mono text-slate-400 uppercase tracking-widest font-bold\" data-kid=\"243\">\n                <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"244\">Security Audit</a>\n                <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"245\">System Log</a>\n                <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"246\">Legal Framework</a>\n            </div>\n            <div class=\"text-[10px] font-mono text-[#0D9488] font-bold\" data-kid=\"247\">\n                PING: 24MS | CPU: 12% | UPTIME: 99.9%\n            </div>\n        </div>\n    </footer>\n\n    \n    <div class=\"absolute top-0 left-0 w-20 h-20 opacity-20 pointer-events-none border-t-2 border-l-2 border-[#E04F3E] m-4\" data-kid=\"248\"></div>\n    <div class=\"absolute bottom-0 right-0 w-20 h-20 opacity-20 pointer-events-none border-b-2 border-r-2 border-[#E04F3E] m-4\" data-kid=\"249\"></div>\n</div>\n",
